/* C:\Shiptest\mod_celadon\weapons\code\modules\projectiles\guns\energy\energy.dm */

/obj/item/gun/energy/e_gun/nanotrasen
	name = "нанотрасен-шарплитовая пушка"
	desc = "пистолет, которым стреляют только в плохих людей."

/obj/item/gun/energy/e_gun/nanotrasen/patriot
	name = "SL X-10 «патриотический» энергетический карабин"
	desc = "Легкий, удобный для ношения вокруг энергетического пистолета. «патриот» служит основным карабином безопасности Nanotrasen-Sharplites, а также является чрезвычайно модульной оружейной платформой."

/obj/item/gun/energy/e_gun/nanotrasen/fuse
	name = "Лазерный карабин SL L-204 «Fuse»"
	desc = "Базовый энергетический лазерный карабин и несколько предшественник X-10. Он славится своей низкой ценой и надежностью."

/obj/item/gun/energy/e_gun/nanotrasen/ember
	name = "SL X-26 «Ember» — миниатюрный энергетический пистолет"
	desc = "Легкий гражданский пистолет Sharplite, популярный среди сотрудников службы безопасности Vigilitas как надежное оружие двойного режима. Технически впечатляет."

/obj/item/gun/energy/e_gun/nanotrasen/hades
	name = "Штурмовая винтовка SL AL-655 Hades"
	desc = "Мощная, сверхсложная энергетическая винтовка, построенная на очень дорогой раме. В то время как громоздкий и неудобный в управлении, количество суппресивного огня, которое он может обеспечить, соответствует только тяжелым баллистическим штурмовым винтовкам."

/obj/item/gun/energy/e_gun/nanotrasen/old
	name = "прототип энергетического пистолета"
	desc = "NT-P:01 Энергетический пистолет. Ранняя стадия разработки уникальной лазерной винтовки, обладающей многогранной энергетической линзой, позволяющей пистолету изменять форму снаряда, которым он стреляет по команде. проект был неудачным, и Nanotrasen позже приобрел Sharplite, чтобы удовлетворить свои потребности в лазерном оружии."

/obj/item/gun/energy/e_gun/nanotrasen/hos
	name = "SL X-01 MultiPhase Energy Gun"
	desc = "Дорогой, вместительный, мощный энергетический пистолет, построенный на шасси Х-00. Модифицированный, чтобы иметь широкий спектр энергетических настроек, включая взрывной режим. предоставлено Vigilitas Security Directors."

/obj/item/gun/energy/e_gun/nanotrasen/hos/brazil
	name = "модифицированная старая лазерная пушка"
	desc = "Он каким-то образом модифицирован, чтобы иметь больше огневых мод."

/obj/item/gun/energy/e_gun/nanotrasen/dragnet
	name = "\improper DRAGnet"
	desc = "Сеть «Динамическое быстрое постижение виновных» — это революция в правоохранительных технологиях."

/obj/item/gun/energy/e_gun/nanotrasen/dragnet/snare
	name = "Энергетическая ракета-носитель"
	desc = "Запускает энергетическую ловушку, которая замедляет цель."

/obj/item/gun/energy/e_gun/nanotrasen/maru
	name = "SL X-14 Maru Advanced Stopping Revolver"
	desc = "продвинутый, тяжелый энергетический пистолет, который способен стрелять в футуристические сети сафари. Револьверный вид в основном используется для маркетинга."

/obj/item/gun/energy/e_gun/nanotrasen/discharger
	name = "SL X-36 «Discharger» Energy SMG"
	desc = "Невероятно компактный двухрежимный энергоблок SMG, предназначенный для маломощной огневой поддержки в полевых условиях. Хотя он выпущен в ограниченном количестве в Нанотрасене, его все еще иногда можно увидеть в руках богатых исследователей и постоянных сотрудников службы безопасности."

/obj/item/gun/energy/e_gun/nanotrasen/discharger/inteq
	name = "VEC-04 «Vuelo» Energy SMG"
	desc = "Невероятно компактный двухрежимный энергоблок SMG, предназначенный для маломощной огневой поддержки в полевых условиях. Закуплен или изъят у Nanotrasen и теперь используется силами IRMG под новой лакокрасочной работой."

/obj/item/gun/energy/e_gun/nanotrasen/chirasu
	name = "SL X-49 «Chirasu» энергетический дробовик"
	desc = "Обременительное, изменяемое энергетическое оружие с многогранной линзой, позволяющей ему функционировать аналогично баллистическому дробовику. Часто используемый для прорыва или обеспечения подавленного огня, он является золотым стандартом для более тяжелых солдат."

/obj/item/gun/energy/e_gun/nanotrasen/chirasu/inteq
	name = "VEC-07 «Quemar» энергетический дробовик"
	desc = "Обременительное, изменяемое энергетическое оружие с многогранной линзой, позволяющей ему функционировать аналогично баллистическому дробовику. Закуплен или изъят у Nanotrasen и теперь используется силами IRMG под новой лакокрасочной работой."

/obj/item/gun/energy/e_gun/nanotrasen/parallax
	name = "SL L-211 «параллакс» Энергетическая винтовка Marksman"
	desc = "Обширная модификация на раме Х-10, отличающаяся более сильными бронебойными болтами и приличным размахом. Редко рассматривается в качестве основного оружия среди личного состава Vigilitas из-за его цены и громоздкости, но он все еще может обеспечить хорошее управление на поле боя в правильных руках."

/obj/item/gun/energy/e_gun/nuclear
	name = "передовая энергетическая пушка"
	desc = "Энергетическая пушка с экспериментальным миниатюрным ядерным реактором, которая автоматически заряжает внутреннюю ячейку питания."

/obj/item/stock_parts/cell/gun
	name = "энергетическая электростанция"
	desc = "проприетарная силовая ячейка, в основном используемая оружием Sharplite Energy. Большая доля рынка Nanotrasen заставила некоторых разработчиков оружия включить адаптеры для этих ячеек"

/obj/item/stock_parts/cell/gun/upgraded
	name = "модернизированная энергетическая ячейка"
	desc = "Ячейка оружия высокой мощности, используемая исключительно оружием Sharplite Energy. Они являются большим улучшением по сравнению со стоковой ячейкой и часто используются коллекционерами, солдатами и операторами тяжелых лазеров."

/obj/item/stock_parts/cell/gun/sharplite
	name = "плазменная силовая установка"
	desc = "проприетарная силовая ячейка, в основном используемая оружием Sharplite Plasma. Большая доля рынка Nanotrasen вынудила некоторых разработчиков оружия включить адаптеры для этих ячеек."

/obj/item/stock_parts/cell/gun/sharplite/plus
	name = "обновленный плазменный силовой элемент"
	desc = "Ячейка оружия высокой емкости, используемая исключительно оружием Sharplite Plasma. Они являются большим улучшением по сравнению со стоковой ячейкой и часто используются коллекционерами, солдатами и операторами тяжелых лазеров."

/obj/item/stock_parts/cell/gun/sharplite/mini
	name = "миниатюрная плазменная силовая ячейка"
	desc = "Компактная ячейка оружия, используемая исключительно оружием Sharplite Plasma. Он содержит меньше заряда и предназначен для использования в энергетических пистолетах."

/obj/item/stock_parts/cell/gun/mini
	name = "миниатюрная энергетическая ячейка"
	desc = "Компактная ячейка оружия, в основном используемая оружием Sharplite Energy. Большая доля рынка Nanotrasen вынудила некоторых разработчиков оружия включить адаптеры для этих ячеек. Он содержит меньше заряда и предназначен для использования в энергетических пистолетах."

/obj/item/stock_parts/cell/gun/sharplite/mini
