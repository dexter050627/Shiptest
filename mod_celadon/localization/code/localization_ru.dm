/obj/item/clothing/under/clip
	name = "\improper SolFed палуба рабочий комбинезон"
	desc = "Комбинезон, который носили непромокаемые рабочие на судах SolFed."

/obj/item/clothing/under/clip/minutemen
	name = "\improper боевая усталость солнечной федерации"
	desc = "Отличительная синяя униформа солнечной федерации, которую носят во время полевых работ и боев. пахнет черникой."

/obj/item/clothing/under/clip/formal
	name = "\improper униформа SolFed"
	desc = "Формальный наряд, состоящий из военно-морских брюк SolFed и белой рубашки. Обычно его видели на белых воротничках чиновников Солфеда, но также носили стрелки вне боя."

/obj/item/clothing/under/clip/medic
	name = "\improper медицинская форма SolFed"
	desc = "Униформа Solar Federation с военно-морскими брюками и синей рубашкой, вышитой белыми плечевыми пятнами. патчи имеют медицинский крест, обозначающий владельца как медицинский персонал."

/obj/item/clothing/under/clip/officer
	name = "\improper форма офицера солнечной федерации"
	desc = "Коричневая служебная форма, используемая офицерами солнечной федерации."

/obj/item/clothing/suit/toggle/lawyer/clip
	name = "\improper куртка офицера Солфеда"
	desc = "причудливая куртка с пуговицами, выданная офицерам солнечной федерации."

/obj/item/clothing/suit/toggle/lawyer/clip/command
	name = "\improper куртка старшего офицера SolFed"
	desc = "причудливая куртка на пуговицах, выданная старшим офицерам солнечной федерации."

/obj/item/clothing/suit/armor/vest/capcarapace/clip
	name = "Общее пальто Solar Federation"
	desc = "Эта яркая одежда используется полевыми генералами солнечной федерации."

/obj/item/clothing/suit/armor/vest/capcarapace/clip/admiral
	name = "Адмирал Федерации Солнца в окопе"
	desc = "Очень причудливый плащ, используемый морскими адмиралами Солнечной Федерации."

/obj/item/clothing/suit/armor/riot/clip
	name = "черный костюм для беспорядков"
	desc = "Окрашенный углем костюм из громоздкой тяжелой брони, предназначенный для ближнего боя и борьбы с беспорядками. Броня выбрана для членов SolFed-BARD, но используется повсеместно. помогает владельцу сопротивляться толканию в тесном помещении."

/obj/item/clothing/suit/armor/clip_trenchcoat
	name = "\improper SolFed trenchcoat"
	desc = "Окоп в цветах солнечной федерации. Несмотря на свою репутацию военного пальто, оно используется всеми подразделениями SolFed. У него много карманов."

/obj/item/clothing/suit/armor/clip_capcoat
	name = "пальто капитана солнечной федерации"
	desc = "пальто выдавалось всем офицерам Солнечной Федерации, достойным звания капитана. Особенности толстой прокладки, которая, будучи защитной, не заменяет надлежащую броню."

/obj/item/clothing/suit/armor/vest/clip_correspondent
	name = "\improper корреспондент бронежилет"
	desc = "Тонкий бронежилет I типа, который обеспечивает достойную защиту от большинства видов повреждений. Белые буквы на лицевой стороне гласили «PRESS» в SolFed — Kalixcian."

/obj/item/clothing/suit/bio_suit/bard
	name = "Биокостюм БАРД-440"
	desc = "Знаменитый биокостюм агентов SolFed-BARD на границе и в других местах."

/obj/item/clothing/head/bio_hood/bard
	name = "BARD-434 био капот"
	desc = "простой, но эффективный и легкий капот для использования с биокостюмами SolFed-BARD."

/obj/item/clothing/head/bio_hood/bard/armored
	name = "Бронированный биокапот BARD-434"
	desc = "Избыточный шлем M10 установлен на синем биокапоте для использования с биокостюмами SolFed-BARD."

/obj/item/clothing/suit/bio_suit/bard/medium
	name = "БАРД-434-2 боевой биокостюм"
	desc = "Специальная модель биокостюма, изготовленная по специальной сертификации SolFed-BARD и выданная командам, ожидающим борьбы с опасной ксенофауной. Смешно."

/obj/item/clothing/suit/bio_suit/bard/heavy
	name = "БАРД-434-3 тяжелый боевой биокостюм"
	desc = "Специальная модель биокостюма, изготовленная по специальной сертификации SolFed-BARD и выданная командам, ожидающим борьбы с опасной ксенофауной. Смешно."

/obj/item/clothing/suit/space/clip
	name = "Космический скафандр SolFed"
	desc = "популярный костюм, изготовленный колониальной лигой, рассчитан на опасные среды низкого давления и высокую температуру. Часто носят различные рабочие и гражданские лица, нанятые лигой."

/obj/item/clothing/head/helmet/space/clip
	name = "Космический шлем SolFed"
	desc = "Космический шлем, изготовленный колониальной лигой, рассчитан на опасные среды с низким давлением и незначительные воздействия. Часто носят различные рабочие и гражданские лица, нанятые лигой."

/obj/item/clothing/suit/space/clip/armored
	name = "Бронированный скафандр SolFed"
	desc = "Бронированный вариант скафандра Solar Federation, заменяющий ткани и добавляющий больше покрытия. Часто выдается шахтерам в опасных местах, полицейским силам или резервистам."

/obj/item/clothing/head/helmet/space/clip/armored
	name = "Космический шлем SolFed"
	desc = "Бронированный вариант космического шлема Solar Federation, меняющий типы покрытий. Часто выдается шахтерам в опасных местах, полицейским силам или резервистам."

/obj/item/clothing/suit/space/hardsuit/clip_patroller
	name = "\improper CM-410 'Patroller' EVA Hardsuit"
	desc = "Жесткий костюм SolFed, адаптированный из еще более старого дизайна. Широко используется в разведке и стычках из-за его легкой конструкции."

/obj/item/clothing/head/helmet/space/hardsuit/clip_patroller
	name = "\improper шлем CM-410 «Patroller» EVA Hardsuit"
	desc = "Шлем для костюма патроллера. Широкий козырь обеспечивает более высокую видимость, чем стандартные боевые костюмы."

/obj/item/clothing/suit/space/hardsuit/clip_spotter
	name = "CM-490 «Spotter» — боевой костюм"
	desc = "Новый, стандартный боевой костюм от SolFed. Тяжелое покрытие неудобно и замедляет владельца."

/obj/item/clothing/head/helmet/space/hardsuit/clip_spotter
	name = "CM-490 «Spotter» — боевой шлем в костюме"
	desc = "Шлем для костюма Споттера. Имеет очень отличительный козырь «Глаза-пауки»."

/obj/item/clothing/head/clip
	name = "\improper Solar Federation service cap"
	desc = "Служебный колпачок, который обычно можно увидеть на Solar Federation всех рангов, но более смелые солдаты могут носить его во время боя. Дизайн восходит к форме, используемой дезертирскими силами Республики Зогил, которые были первыми гражданами Солфеда."

/obj/item/clothing/head/clip/corpsman
	name = "\improper медицинская шапка Solar Federation"
	desc = "Крышка обслуживания, которую можно увидеть на Solar Federation, выбирает медицину в качестве своей профессии. Дизайн восходит к форме, используемой дезертирскими силами Республики Зогил, которые были первыми гражданами Солфеда."

/obj/item/clothing/head/clip/slouch
	name = "\improper шляпа офицера солнечной федерации"
	desc = "Командная шляпа, выданная старшим рядовым и младшим офицерам солнечной федерации."

/obj/item/clothing/head/clip/slouch/officer
	name = "\improper шляпа старшего офицера солнечной федерации"
	desc = "Командующая сутулая шляпа с белым значком, подаренная высшим офицерам Солнечной Федерации."

/obj/item/clothing/head/clip/boonie
	name = "Лучшая шляпа от Solar Federation"
	desc = "Широкая опоясанная шапка в цветах солнечной федерации, чтобы держать себя в прохладе во время жаркой погоды."

/obj/item/clothing/head/clip/bicorne
	name = "\improper солнечный бикорн Федерации"
	desc = "Большой, яркий бикорн, используемый генералами Солнечной Федерации."

/obj/item/clothing/head/helmet/bulletproof/x11/clip
	name = "Солнечная федерация CM-11"
	desc = "Большой, громоздкий пуленепробиваемый шлем в отличительной синей окраске Солнечной Федерации. Имеет небольшой рельс крепления на стороне, где вы можете установить фонарик."

/obj/item/clothing/head/helmet/m10/clip
	name = "Солнечная Федерация CM-10 Helmet"
	desc = "Дешевый, но удобный и легкий шлем, окрашенный в цвета Solar Federation, часто виден в руках заповедников или Solar Federation в тылу. Имеет небольшой рельс крепления на стороне, где вы можете установить фонарик."

/obj/item/clothing/head/helmet/m10/clip_vc
	name = "Вертолет Solar Federation CM-12"
	desc = "Специальный, легкий и мягкий шлем, выпущенный для экипажей транспортных средств солнечной федерации. Имеет технологию снижения шума и микрофон, который автоматически соединяется с изношенными гарнитурами. Надеюсь, защитит вас от ухабистой езды."

/obj/item/clothing/head/helmet/m10/clip_correspondent
	name = "Военный корреспондент M10 Helmet"
	desc = "Легкий пуленепробиваемый шлем передан военным корреспондентам SolFed. Имеет небольшой рельс крепления на стороне, где вы можете установить фонарик. Опустите голову!"

/obj/item/clothing/head/helmet/riot/clip
	name = "Солнечная Федерация CM-13 Riot Helmet"
	desc = "прочный синий шлем, сделанный с учетом контроля толпы. Складной защитный козырек делает его предпочтительным шлемом SolFed-BARD против враждебной ксенофауны."

/obj/item/clothing/head/fedora/det_hat/clip
	name = "\improper SolFed-GOLD fedora"
	desc = "Редкий вид на границе, выданный членам дивизии Солфед-Голд. предназначена для того, чтобы выглядеть более непринужденно, но все же столь же модно, как и средняя одежда SolFed."

/obj/item/clothing/head/flatcap/clip
	name = "\improper SolFed-GOLD flatcap"
	desc = "Квартира, выданная членам подразделения SolFed-GOLD. Шляпа офисного работника."

/obj/item/storage/belt/military/clip
	name = "\improper Solar Federation chest rig"
	desc = "Эта установка имеет много больших мешочков, окрашенных в синий цвет Solar Federation. Большая часть мешков делает его лишь слегка неудобным для ношения."

