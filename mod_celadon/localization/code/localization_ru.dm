	desc = "Военный беспилотный летательный аппарат, адаптированный компанией Ramzi’s Clique для разведки и быстрого реагирования. Десятимиллиметровый станкопистол на его подвесной установке отслеживает ваши движения."

/mob/living/simple_animal/hostile/automated/quadrotor/makosso
	name = "Дрон Vigilitas"
	desc = "Оборонительный беспилотник производства Sharplite."

/mob/living/simple_animal/hostile/automated/rover
	name = "Vigilitas\"Scenthound\" защитный ровер"
	desc = "Скаутский дрон, изготовленный Шарплитом во время межкорпоративной войны. Обычно выставляются небольшими передовыми группами перед командами Вигилитаса или размещаются на контрольно-пропускных пунктах безопасности."

/mob/living/simple_animal/hostile/automated/rover/coalition
	name = "Боевой марсоход «Teemeres»"
	desc = "Боксовый дрон, изготовленный компанией Cybersun во время межкорпоративной войны. Стилизованный, чтобы быть как можно более простым и бронированным, чтобы соединиться с силами мародеров, Teemeres получил положительную репутацию надежного отвода против вражеских сил."

/mob/living/simple_animal/hostile/automated/rover/coalition/dmr
	name = "«Темер-Лито» боевой марсоход"
	desc = "Боксовый дрон, изготовленный компанией Cybersun во время межкорпоративной войны. Стилизованный, чтобы быть как можно более базовым и бронированным, чтобы слиться с силами мародеров, Темере-Лито получил плохую репутацию за свою склонность к попаданию в наступающих мародеров."

/mob/living/simple_animal/hostile/automated/rover/ngr
	name = "«Teemeres» — оборонный марсоход"
	desc = "Боксовый дрон производства New Gorlex Republic. Фактически такой же, как оригинальный ровер Teemeres, с современным NGR IFF. Современный Teemeres получил новую роль в качестве беспилотника безопасности контрольно-пропускных пунктов для объектов NGR."

/mob/living/simple_animal/hostile/automated/rover/ngr/dmr
	name = "«Темер-Лито» оборонный марсоход"
	desc = "Боксовый дрон производства New Gorlex Republic. Фактически то же самое, что и в оригинальном Temere-Lito, хотя и с улучшенными системами IFF, чтобы помочь предотвратить инциденты пожара. Современный Temere-Lito получил новую роль в качестве разведывательного беспилотника, который иногда используется в миссиях по исследованию планет."

/mob/living/simple_animal/hostile/automated/agrav
	name = "Гравитационный дрон Verefasa"
	desc = "передовая форма боеприпаса, разработанная Cybersun, когда ICW подошла к концу. Большая часть ботов была перепрофилирована в простые рабочие беспилотники для Cybersun и его партнеров после ICW, это просто так случилось, чтобы быть одним для вас."

/mob/living/simple_animal/hostile/automated/agrav/cybersun
	name = "Боевые боеприпасы Verefasa"
	desc = "передовая форма боеприпаса, разработанная Cybersun как ICW, подошла к концу; Verefasa содержит едва чувствующий боевой ИИ для автономных операций, гравитический индукционный привод и сердце микрофузии. Часто развернутые в массовом порядке, чтобы сделать восстановление области болью, спейсеры рассказывают ужасные истории о столкновении ульев Верефасы, активных на требованиях спасения в глубоком космосе."

/mob/living/simple_animal/hostile/automated/bipedal
	name = "Бипедальная штурмовая платформа"
	desc = "Неуклюжий автомат, одетый в цвета Коалиции, с интегрированным дробовиком, прикрепленным на месте левой руки. Движимый базовым программным обеспечением обнаружения угроз, ствол его дробовика удерживает себя в вашем направлении."

/mob/living/simple_animal/hostile/automated/walkmine
	name = "G-80W Walkmine"
	desc = "Нетрадиционная модификация традиционного G-80P Bouncer. Известный как «упреждающее решение для сомнительных злоумышленников», использование Walkmine было запрещено в большинстве юрисдикций после межкорпоративной войны."

