/obj/item/clothing/neck/cloak/nanotrasen
	name = "командующий sash"
	desc = "Красный шелковый ломтик, который хорошо сочетался бы с формальной униформой. Небольшой тег внутри декларирует это свойство корпорации Nanotrasen"

/obj/item/clothing/neck/cloak/cap
