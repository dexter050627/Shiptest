/* C:\Shiptest\mod_celadon\weapons\code\modules\projectiles\guns\ballistic\assault.dm */

/obj/item/gun/ballistic/automatic/assault/g36
	name = "\improper G36"
	desc = "Элитная штурманская винтовка в Солнечной Федерации. Родина - Родина - Родина Значение,  модель  модель  модель  модель  модель . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .. В. КЛЮЧАЕМЫЙ РЕЗУЛЬТАТНЫЙ БЕКГЮНТ и ДЕЯТЕЛЬСКИЙ МАЛЬТУР. Использует патроны калибра 5,56×45 мм."

/obj/item/gun/ballistic/automatic/assault/g36/inteq
	name = "\improper G36m"
	desc = "Элитная штурманская винтовка ИнтеКью.Автомобильный болид G36 G36 «Солнечный Арсенал». См. также: Flock пустого магазина. Использует патроны калибра 5,56×45 мм."

/obj/item/gun/ballistic/automatic/assault/morita1
	name = "Импровизация Morita MK.I"
	desc = "Стандартная стрелковая машина, автоматическая винтовая машина .308. Широко-относительная армия смягчает положение дел в Союзе Челаче. популярность, мобилизованная в рамках программы Starboat Troopes."

/obj/item/gun/ballistic/automatic/marksman/svd
	name = "Снайперская винтовка SR-33 Dragunov"
	desc = "полуавтоматическая снайперская винтовка, известная своей стрельбой, и построена для нее с нуля. Огонь 7.62x54mmR патронов."

/obj/item/gun/ballistic/automatic/assault/cm82/solfed
	name = "Модель 82 Carbine"
	desc = "Стандартная солярианская штурмовая винтовка, несколько устаревшая, но все же точная, надежная и простая в использовании. Эта версия была изготовлена в республике Элизиум по лицензии солнечной федерации для бригады Элизиум. Замещался в 5,56х42 мм."

/* C:\Shiptest\mod_celadon\weapons\code\modules\projectiles\guns\ballistic\gun_reflavour.dm */

/obj/item/gun/ballistic/automatic/pistol/cm70
	name = "пистолет-пулемет CM-70"
	desc = "Компактный пулеметный пистолет, предназначенный для быстрой стрельбы 3-х круговыми очередями. популярный среди офицеров и некоторых спецподразделений, CM-70 невероятно опасен на близком расстоянии. Закрыто на 9 мм."

/obj/item/gun/ballistic/automatic/pistol/cm357
	name = "\improper CM-357"
	desc = "Этот мощный полуавтоматический пистолет был разработан после того, как было осознано, что пространство слишком опасно в виде мегафауны, и что стандартные пистолеты были неэффективны в качестве резервного оружия. Вес и мощь оружия сделали его символом статуса среди немногих солярианских офицеров, способных его реквизировать. Закрыто в .357."

/obj/item/gun/ballistic/automatic/smg/cm5
	name = "\improper CM-5"
	desc = "пистолет-пулемет стандартного выпуска SolFed. понравился своей точностью, стабильностью и простотой использования по сравнению с другими пистолетами-пулеметами. Закрыто на 9 мм."

/obj/item/gun/ballistic/automatic/smg/cm5/compact
	name = "\improper CM-5c"
	desc = "Модификация CM-5 с резко укороченным бочком и снятым запасом. предназначен для скрытых оперативников, чтобы максимизировать мобильность, не жертвуя огневой мощью, хотя точность на расстоянии в лучшем случае ужасна. Закрыто на 9 мм."

/obj/item/gun/ballistic/automatic/smg/skm_carbine/saber
	name = "\improper Saber SMG"
	desc = "пистолет-пулемет 9х18 мм, обозначенный как «TPG SABR». Имеет резьбовую бочку для супрессоров и складной запас. Этот странный пистолет действительно устарел..."

/obj/item/gun/ballistic/automatic/marksman/f4
	name = "CM-F4"
	desc = "Стрелковая винтовка Солфеда, используемая как военными, так и правоохранительными органами. Разработанный вскоре после CM-24, F4 хорошо адаптировался к постоянным обновлениям. Закрыто в .308."

/obj/item/gun/ballistic/automatic/marksman/f4/indie
	name = "\improper F3"
	desc = "Старая модель винтовки Solarian F4, разработанная очень рано в истории человечества. Большинство из них были проданы как излишки к этому моменту и, как правило, страдают от внутреннего износа из-за их возраста. Закрыто в .308."

/obj/item/gun/ballistic/automatic/marksman/f90
	name = "CM-F90"
	desc = "Мощная снайперская винтовка, используемая исчезающе редкими специалистами-снайперами, способными к впечатляющей дальности и проникающей мощности. Закрыто в 6.5x57 мм."

/obj/item/gun/ballistic/automatic/assault/cm82
	name = "\improper CM-82"
	desc = "Самая стандартная штурмовая винтовка солнечной федерации, относительно новое служебное оружие. Точная, надежная и простая в использовании, CM-82 заменила CM-24 в качестве штурмовой винтовки SolFed почти за одну ночь. В камере 5.56x40 мм."

/obj/item/gun/ballistic/automatic/assault/skm/cm24
	name = "\improper CM-24"
	desc = "Устаревшая и очень прочная штурмовая винтовка с тяжелым снарядом и медленным действием для своего класса. Когда-то стандартная штурмовая винтовка всего человечества, выпускавшаяся в феноменальных количествах по «в основном неизвестным причинам», если и редкая, то боевая винтовка. помещено в 7.62x40 мм."

/obj/item/gun/ballistic/automatic/hmg/cm40
	name = "\improper CM-40"
	desc = "Легкий пулемет, используемый командами тяжелого вооружения SolFed, способный затухать подавляющий огонь. Вес и отдача делают практически невозможным использование без развертывания бипода против соответствующей крышки, такой как стол, или крепления к твердой крышке. помещено в 7.62x40 мм."

/obj/item/gun/ballistic/shotgun/cm15
	name = "\improper CM-15"
	desc = "Большой автоматический дробовик, используемый Solar Federation. Он обычно используется правоохранительными органами и специалистами по нарушениям, а иногда используется с зажигательными боеприпасами, если правила растягиваются «по-разному». В камере 12 калибра."

/obj/item/gun/ballistic/revolver/rhino
	name = "VI Носорог"
	desc = "Очень известный мощный полуавторевольвер, часто используемый высокопоставленными чиновниками CentCom и офицерами Vigilitas Interstellar. Закрыто в .357."

