/obj/item/gun/ballistic/automatic/pistol/cm23
	name = "\improper CM-23"
	desc = "Стандартный служебный пистолет CLIP. 10 патронов калибра 10 мм делают CM-23 более смертоносным, чем многие другие служебные пистолеты, но его вес и объем сделали его непопулярным в качестве оружия. Она в значительной степени была прекращена за пределами специализированных подразделений и патрулей на окраинах пространства CLIP. В камере на 10 мм."

/obj/item/ammo_box/magazine/cm23
	name = "пистолетный журнал CM-23 (10 мм)"
	desc = "10-раундовый журнал, предназначенный для пистолета CM-23. Эти снаряды наносят умеренный урон, но борются с броней."

/obj/item/gun/ballistic/automatic/pistol/cm70
	name = "пистолет-пулемет CM-70"
	desc = "Компактный пулеметный пистолет, предназначенный для быстрой стрельбы 3-х круговыми очередями. популярный среди офицеров и некоторых спецподразделений, CM-70 невероятно опасен на близком расстоянии. Закрыто на 9 мм."

/obj/item/ammo_box/magazine/m9mm_cm70
	name = "Оружейный журнал CM-70 (9 мм)"
	desc = "18-зарядный журнал, предназначенный для пистолета-пулемета CM-70. Эти патроны наносят хороший урон, но борются с броней."

/obj/item/ammo_box/magazine/cm357
	name = "пистолетный журнал CM-357 (.357)"
	desc = "7-зарядный магазин, предназначенный для пистолета CM-357. Эти снаряды наносят хороший урон, но борются с броней."

/obj/item/ammo_box/magazine/cm5_9mm
	name = "Журнал CM-5 (9 мм)"
	desc = "30-раундовый журнал для пистолета-пулемета СМ-5. Эти патроны наносят хороший урон, но борются с броней."

/obj/item/gun/ballistic/automatic/marksman/f4/inteq
	name = "\improper SsG-04"
	desc = "Винтовка F4 приобретена у CLIP и модифицирована в соответствии с потребностями IRMG. Закрыто в .308."

/obj/item/ammo_box/magazine/f90
	name = "\improper CM-F90 Magazine (6.5x57mm CLIP)"
	desc = "Большой 6-раундовый магазин для снайперских винтовок CM-F90. Эти снаряды наносят удивительные повреждения и обходят половину их защитного снаряжения, хотя это не достаточно высокий калибр, чтобы пробить бронетехнику."

/obj/item/gun/ballistic/automatic/marksman/f90/inteq
	name = "SSG-08 Saluki"
	desc = "Мощный снайпер, купленный у CLIP, слегка модифицированный с поверхностными модификациями и краской IRMG. В камере 6,5 мм."

/obj/item/ammo_box/magazine/cm40_762_40_box
	name = "Коробочный журнал CM-40 (7.62x40mm CLIP)"
	desc = "80 круглых коробок для легкого пулемета CM-40. Эти снаряды наносят хороший урон при хорошей бронепробиваемости."

/obj/item/gun/ballistic/automatic/hmg/rottweiler
	name = "\improper KM-05 Rottweiler"
	desc = "Винтовка F4, приобретенная у CLIP и широко модифицированная в пулемет с ленточной подачей. Тяжелый и стреляющий мощным патроном, это оружие громоздкое без поддержки бипода. Уникально, что KM-05 Rottweiler может хорошо принимать журналы F4."

/obj/item/ammo_box/magazine/rottweiler_308_box
	name = "Журнал Rottweiler Box (308)"
	desc = "50-ти круглых коробок для пулемета Ротвейлера. Эти снаряды наносят хороший урон при значительном бронепробиваемости."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\clip_lanchester\lasers.dm */

/obj/item/gun/energy/kalix/clip
	name = "ECM-6"
	desc = "Модернизированная копия ECM-1, первого служебного оружия CLIP. Он имеет ряд улучшений, чтобы вернуть стареющий дизайн в современную эпоху."

/obj/item/gun/energy/kalix/clip/old
	name = "ECM-1"
	desc = "Это либо безупречная копия, либо подлинный пример лазерного оружия колониальной эпохи, выпущенного силам Свободного Зогила в годы основания CLIP. Более ста лет, и особенно трудно найти запасные части, но все же смертельно. Держался для церемониального использования в CLIP Minutemen, и, редко, для влиятельных членов всех подразделений."

/obj/item/gun/energy/laser/e50/clip
	name = "ECM-50"
	desc = "Обширная модификация Eoehoma E-50 Emitter от Clover Photonics, настроенная для CLIP-BARD для борьбы с Ксенофауной. пожертвовал необработанной энергией E-50, чтобы значительно повысить энергоэффективность, сохраняя при этом его зажигательные побочные эффекты."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\eoehoma\ballistics.dm */

/obj/item/gun/ballistic/automatic/assault/e40
	name = "Гибридная винтовка E-40"
	desc = "Гибридная штурмовая винтовка, наиболее известная тем, что имеет двойную баллистическую / лазерную систему вместе с усовершенствованным счетчиком боеприпасов. Когда-то икона для охотников за головами, возраст сломался больше всего, поэтому они оказываются в руках коллекционера или в виде дрянных лазерных преобразований Frontiersmen SMG, когда в их наследственных запасах. Но если бы кто-то нашел его в рабочем состоянии, это было бы так же страшно, как тогда. Камера .299 Eoehoma не имеет корпуса и использует энергию для лазеров."

/obj/item/gun/energy/laser/e40_laser_secondary
	name = "вторичная лазерная пушка e40"
	desc = "Лазерный компонент гибридной винтовки Е-40. Тебе, наверное, не стоит этого видеть. Если вы можете, вы, вероятно, должны знать, что это первично, баллистический компонент во Вселенной вторичен. К сожалению, мы не можем смоделировать это, так что по коду это вторично."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\eoehoma\lasers.dm */

/obj/item/gun/energy/laser/e10
	name = "Лазерный пистолет E-10"
	desc = "Очень старое лазерное оружие. Несмотря на крайний возраст некоторых из этих видов оружия, они иногда предпочитают более новое, серийное лазерное оружие."

/obj/item/gun/energy/e_gun/e11
	name = "Гибридная энергетическая винтовка E-11"
	desc = "Гибридный энергетический пистолет с любовью запомнился как одно из худших видов оружия, когда-либо созданных. Больно, но это только в том случае, если ему удается поразить цель."

/obj/item/gun/energy/laser/e50
	name = "Излучатель энергии Е-50"
	desc = "Тяжелый и чрезвычайно мощный лазер. Устанавливает цели на огонь и пинает зад, но он использует огромное количество энергии на выстрел и, как правило, неудобно обращаться."

/obj/item/gun/energy/disabler/e60
	name = "E-60 Инвалид личной защиты"
	desc = "Оружие самообороны, которое истощает органические цели, ослабляя их, пока они не рухнут."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\etherbor\energy_gunsword.dm */

/obj/item/gun/energy/kalix
	name = "\improper Etherbor BG-12"
	desc = "BG-12 является текущей моделью гражданской лучевой пушки Etherbor Industries. Энерголучевая пушка BG-12 практически идентична военной модели, запрещающей снятие полного автоматического режима. Иначе это ничем не отличается от старых лучевых пушек из истории Каликсиса."

/obj/item/gun/energy/kalix/nock
	name = "\improper Etherbor VG-F3"
	desc = "Etherbor Industries VG-F3 является еще одним усовершенствованием устаревшей концепции лучевого волейгуна. первый в своем роде, который нашел коммерческий успех в наши дни, VG-F3 нашел удобную нишу с правоохранительными органами и внутренними рынками обороны по всей галактике."

/obj/item/gun/energy/kalix/pgf/nock
	name = "\improper Etherbor VG-A5"
	desc = "Опираясь на успех VG-F3, Etherbor Industries VG-A5 Beam Volleygun был разработан специально для контрактной продажи вооруженным силам PGF. С добавлением более сильного конденсатора и передней хватки VG-A5 стал популярным среди морских рейдеров за его способность брать под контроль тесные пространства."

/obj/item/gun/energy/kalix/pgf
	name = "\improper Etherbor BG-16"
	desc = "предназначенный в качестве основного оружия ближнего боя вооруженных сил PGF, Etherbor BG-16 торгует стабильностью и мощью на расстоянии для впечатляющей мощности выстрела."

/obj/item/gun/energy/kalix/pgf/pdw
	name = "\improper Etherbor SGR-9"
	desc = "Компактная рама Etherbor SGR-9, поддерживаемая экипажами транспортных средств, артиллеристами, логистическим персоналом и многим другим, идеально подходит для войск тылового эшелона, которые все еще могут ожидать каких-либо действий."

/obj/item/gun/energy/kalix/pgf/medium
	name = "\improper Etherbor BGC-10"
	desc = "Ответ Этербора на запрос вооруженных сил PGF на оружие в стиле карабина; BGC-10 предлагает большую точность и мощность, чем BG-16, будучи менее громоздким, чем винтовки серии HBG."

/obj/item/gun/energy/kalix/pgf/heavy
	name = "\improper Etherbor HBG-7"
	desc = "HBG-7 является стандартным стрелковым оружием вооруженных сил PGF. Он оснащен специальным режимом DMR, который имеет больший прокалывание брони для борьбы с бронированными целями."

/obj/item/gun/energy/kalix/pgf/heavy/sniper
	name = "\improper Etherbor HBG-7L"
	desc = "HBG-7 с более длинным стволом и размахом. предназначенный для лучшего использования из режима DMR, он страдает от более длительного времени использования и большего замедления, но более длинный ствол делает его идеальным для точной стрельбы."

/obj/item/gun/energy/kalix/hunt
	name = "\improper Etherbor HBS-110"
	desc = "Самый популярный охотничий луч Этербора на сегодняшний день, HBS-110 может похвастаться точной точностью за счет объективно громоздкой длины. Нестандартный дизайн оружия собрал культ для платформы, но также породил некоторые разногласия на зарубежных рынках."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\frontier_import\ballistics.dm */

/obj/item/gun/ballistic/automatic/pistol/mauler
	name = "пистолет-машина Морера"
	desc = "Автоматический пистолет-пулемет, происходящий из Шоала. Впечатляющий объем огня с высокой отдачей, слабая бронепробиваемость и ограниченный размер магазина затрудняют его использование за пределами близких помещений. Закрыто на 9 мм."

/obj/item/gun/ballistic/automatic/pistol/mauler/regular
	name = "пистолет Морера"
	desc = "полуавтоматическая версия Mauler. по-прежнему быстро стрелять с лучшей точностью, чем его автомобильный аналог, но он все еще неточен по сравнению с большинством современных пистолетов. Закрыто на 9 мм."

/obj/item/ammo_box/magazine/m9mm_mauler
	name = "маулер пистолет журнал (9 мм)"
	desc = "8-раундовый журнал, предназначенный для пистолета Маулер."

/obj/item/ammo_box/magazine/m9mm_mauler/extended
	name = "пистолет-пулемет маулер с расширенным магазином (9 мм)"
	desc = "12-зарядный журнал, предназначенный для пистолета-пулемета Маулер."

/obj/item/gun/ballistic/automatic/pistol/spitter
	name = "\improper Spitter"
	desc = "пулемет с открытым болтом, который предпочитают пограничники. происхождение этого дизайна неясно, но его простой, надежный дизайн был широко скопирован по всей границе, и он стереотипно используется пиратами и различными преступными группами, которые ценят низкую цену и простоту сокрытия. Закрыто на 9 мм."

/obj/item/ammo_box/magazine/spitter_9mm
	name = "spitter pistol magazine (9 мм)"
	desc = "Тонкий 30-раундовый магазин для пистолета-пулемета Spitter."

/obj/item/gun/ballistic/automatic/smg/pounder
	name = "Грязь"
	desc = "Необычный пистолет-пулемет производства Frontiersman. Небольшой патрон, не имеющий как тормозной мощности, так и бронепробиваемости, компенсируется лучшей в своем классе боекомплектностью и скоростью цикла. Закрыто в .22 LR."

/obj/item/ammo_box/magazine/c22lr_pounder_pan
	name = "пан журнал (.22 LR)"
	desc = "50-раундовый сковородок для пистолета-пулемета Pounder."

/obj/item/gun/ballistic/automatic/hmg/shredder
	name = "\improper Shredder"
	desc = "Очень нетипичный тяжелый пулемет, сильно модифицированный пограничниками. Дополнительные захваты были добавлены, чтобы включить стрельбу из бедра, и он был изменен на огневые пояса снарядов дробовика. помещено в 12г."

/obj/item/ammo_box/magazine/m12_shredder
	name = "поясная коробка (12 г)"
	desc = "40-раундовая ленточная коробка для тяжелого пулемета Шреддера."

/obj/item/ammo_box/magazine/m12_shredder/slug
	name = "поясная коробка (12 г слизняка)"
	desc = "40-раундовая ленточная коробка для тяжелого пулемета Шреддера."

/obj/item/gun/ballistic/automatic/hmg/skm_lmg
	name = "\improper SKM-24u"
	desc = "То, что на первый взгляд кажется стандартным СКМ-24, на самом деле представляет собой легкую пулеметную конверсию с удлиненным тяжелым стволом и капитально отремонтированными внутренними деталями. Его вес, объем и высокая скорострельность затрудняют обработку без использования бипода в положении лежа или против соответствующего покрытия, такого как стол. Занят в 7.62x40mm CLIP."

/obj/item/gun/ballistic/automatic/hmg/mower
	name = "\improper Мотор"
	desc = "Огромный и относительно точный HMG, Mower построен для тяжелой огневой поддержки на ходу. Закрыто в .308."

/obj/item/ammo_box/magazine/mower_lmg_308
	name = "пулеметный барабан (.308)"
	desc = "Барабанная форма, 50-раундовый магазин для пулемета Mower .308. Эти патроны наносят хороший урон превосходной бронепробиваемостью."

/obj/item/gun/ballistic/rocketlauncher/oneshot
	name = "\improper Хаммер"
	desc = "Одноразовый реактивный гранатомет, загруженный стандартным снарядом HE."

/obj/item/gun/ballistic/rocketlauncher/oneshot/hedp
	name = "Обсуждение Hammer-DP"
	desc = "Одноразовый гранатомет, загруженный снарядом HEDP для прямого проникновения вашей цели."

/obj/item/gun/ballistic/shotgun/automatic/slammer
	name = "\improper Slammer"
	desc = "Необычный, устаревший дробовик, происходящий из Ланчестер-Сити. Часто в руках пиратов и эксцентричных инди, это оружие является маг-кормом и насосным действием."

/obj/item/ammo_box/magazine/m12g_slammer
	name = "slammer box magazine (12 г)"
	desc = "Однокомпонентный 6-раундовый журнал для дробовика Slammer и его производных."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\frontier_import\lasers.dm */

/obj/item/gun/energy/laser/wasp
	name = "Оса"
	desc = "В то время как E-40 была лучшей лазерной винтовкой, многие из них терпели неудачу. Таково решение этой проблемы новыми пограничниками. Удаление баллистических деталей при сохранении внутренней электроники. Они также принимают современные силовые ячейки Макоссо-Варры в обмен на более слабую линзу."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\hunter_pride\ballistics.dm */

/obj/item/gun/ballistic/revolver/montagne
	name = "производитель HP Montagne"
	desc = "Орнативный револьвер, выпущенный для высокопоставленных членов ополчения Сен-Румена. Закрыто в .44."

/obj/item/gun/ballistic/revolver/ashhand
	name = "HP Ashhand"
	desc = "Массивный длинноствольный револьвер, часто используемый ополчением Сен-Румена в качестве защиты от большой игры. Можно перезаряжать только один картридж за раз благодаря его усиленной раме. Использует патроны 45-70."

/obj/item/gun/ballistic/revolver/firebrand
	name = "производитель HP Firebrand"
	desc = "Архаичный предшественник револьверного огнестрельного оружия, это оружие было полностью устаревшим тысячелетия назад. В то время как быстро стрелять, это очень неточно. Использует патроны 357."

/obj/item/gun/ballistic/revolver/shadow
	name = "Обсуждение HP Shadow"
	desc = "Револьвер среднего размера. Несмотря на устаревший дизайн, он дешев, надежен и стильен, что делает его фаворитом среди быстроходных спейсеров и офицеров различных вооруженных сил, а также небольших полицейских подразделений. Закрыто в .44."

/obj/item/gun/ballistic/revolver/detective
	name = "Специальный детектив HP"
	desc = "Небольшое огнестрельное оружие правоохранительных органов. первоначально созданный по заказу Vigilitas Interstellar для их отдела частных расследований, он стал чрезвычайно популярным среди независимых гражданских лиц как дешевое компактное оружие. Использует 38 специальных патронов."

/obj/item/gun/ballistic/automatic/pistol/candor
	name = "\improper Кандор"
	desc = "Классический полуавтоматический пистолет, широко популярный на всей границе. Гравировка на слайде отмечает его как продукт гордости Хантера. Закрыто в 45."

/obj/item/gun/ballistic/automatic/pistol/candor/phenex
	name = "производитель HP Phenex"
	desc = "Уникально модифицированная версия Candor, созданная Hunter’s Pride. Названный в честь демонического Феникса легенды о том, что Ашен Хантсман когда-то убил, это оружие, поцелованное в ад, более визуально пугающее, чем его оригинальный аналог, но механически действует так же. Закрыто в 45."

/obj/item/gun/ballistic/shotgun/doublebarrel
	name = "двуствольный дробовик"
	desc = "Классический дробовик, сделанный вручную в мастерской Hunter's Pride. Оба ствола могут быть выпущены в быстрой последовательности или даже одновременно. Оружие было популярно среди охотников, спортсменов и преступников на протяжении тысячелетий. помещено в 12г."

/obj/item/gun/ballistic/shotgun/doublebarrel/presawn
	name = "двуствольный дробовик"
	desc = "Дробовик брейк-экшена срезан до размера бокового оружия. Хотя отдача еще более жесткая, она предлагает много энергии в очень маленьком пакете. помещено в 12г."

/obj/item/gun/ballistic/shotgun/doublebarrel/roumain
	name = "Древний двухствольный дробовик HP"
	desc = "Специальное издание дробовика ручной работы Hunter's Pride с высококачественным грецким орехом, инкрустированным латунной прокруткой. Такие дробовики очень редки за пределами рядов ополчения Сен-Румена. В остальном функционально идентичен обычному двухствольному дробовику. помещено в 12г."

/obj/item/gun/ballistic/shotgun/brimstone
	name = "HP Brimstone"
	desc = "простой и прочный дробовик с насосным действием мощностью 5 раундов, изготовленный Hunter's Pride. Широко распространен по всей границе в руках охотников, пиратов, полиции и многих других. помещено в 12г."

/obj/item/gun/ballistic/shotgun/hellfire
	name = "Адский огонь"
	desc = "Огромный дробовик с восемью кругами, изготовленный Hunter's Pride. Особенно популярен среди полицейских пограничников. помещено в 12г."

/obj/item/gun/ballistic/shotgun/flamingarrow/conflagration
	name = "HP пожар"
	desc = "Легкий дробовик рычажного действия с боекомплектом 5 патронов. Действие рычага позволяет быстро и точно циклировать его. Теоретически, вы можете управлять им одной рукой. помещено в 12г."

/obj/item/gun/ballistic/shotgun/doublebarrel/twobore
	name = "HP Huntsman"
	desc = "Комично огромная двухствольная винтовка, изобилующая медными вставками, изображающими пламя и натуралистические сцены, явно предназначенные для самых отвратительных монстров, которые может предложить Frontier. Если вы хотите неповрежденный трофей, не целитесь в голову. Заперта в двухстволе."

/obj/item/gun/ballistic/rifle/illestren
	name = "производитель HP Illestren"
	desc = "прочная и обычная винтовка с болтовым действием. Один из самых успешных видов огнестрельного оружия Hunter's Pride, Illestren популярен среди колонистов, пиратов, снайперов и многих других. В камере 8x50mmR."

/obj/item/gun/ballistic/shotgun/flamingarrow
	name = "Огненная стрела HP"
	desc = "прочная и легкая винтовка с ручным штампом Hunter's Pride на приемнике. популярный выбор среди пограничных усадеб для охоты на мелкую дичь и элементарной самообороны. Закрыто в 38-м."

/obj/item/gun/ballistic/shotgun/flamingarrow/bolt
	name = "HP Flaming Bolt"
	desc = "прочная, отлично сделанная винтовка с рычагом. Этот, кажется, настоящий антиквариат, сохранившийся в невероятно хорошем состоянии, несмотря на преклонный возраст. Закрыто в 38-м."

/obj/item/gun/ballistic/shotgun/flamingarrow/absolution
	name = "HP абсолютизация"
	desc = "Большая винтовка с ручным штампом Hunter's Pride на приемнике и боекомплектом 8 патронов. Более мощный, чем огненная стрела, абсолют является популярным выбором для охоты на более крупную фауну, такую как медведи и голиафы, особенно когда более медленная скорость затвора будет обузой. Закрыто в .357."

/obj/item/gun/ballistic/shotgun/flamingarrow/pyre
	name = "HP Pyre"
	desc = "Мощная винтовка с ручным штампом Hunter's Pride на приемнике и боекомплектом 5 патронов. Крутой и громоздкий, но разрушительно мощный. Закрыто в .45-70."

/obj/item/gun/ballistic/shotgun/doublebarrel/beacon
	name = "HP Beacon"
	desc = "Винтовка, сделанная Hunter's Pride и проданная гражданским охотникам. Обладает отличной точностью и останавливающей силой. Использует патроны 45-70."

/obj/item/gun/ballistic/rifle/scout
	name = "HP Scout"
	desc = "Мощная винтовка с болтовым действием, обычно дается наемникам-охотникам из ополчения Сен-Румена, в равной степени пригодная для уничтожения большой игры или двуногих. Замкнулся в 300-м Магнуме."

/obj/item/gun/ballistic/automatic/assault/invictus
	name = "HP Invictus"
	desc = "Неповоротливая автоматическая винтовка, выпущенная ополчением Сен-Румена, обычно продается полицейским силам и частным покупателям. Этот имеет гладкую деревянную отделку и находится в первозданном состоянии. Закрыто в .308."

/obj/item/ammo_box/magazine/invictus_308_mag
	name = "Журнал Invictus (308)"
	desc = "20 круглых коробок для автоматической винтовки Invictus. Эти снаряды наносят хороший урон при значительном бронепробиваемости."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\scarborough\ballistics.dm */

/obj/item/gun/ballistic/automatic/pistol/ringneck
	name = "PC-76 «Ringneck»"
	desc = "Компактный пистолет, используемый большинством групп, связанных с Синдикатом. Он достаточно мал, чтобы спрятаться в большинстве карманов, что делает его популярным для скрытых элементов и просто в качестве компактного оборонительного оружия. В камере на 10 мм."

/obj/item/gun/ballistic/automatic/pistol/ringneck/indie
	name = "Рингнек-76"
	desc = "Служебный пистолет, популярный среди правоохранительных органов, наемников и независимых спейсеров с проницательными вкусами. В камере на 10 мм."

/obj/item/ammo_box/magazine/m10mm_ringneck
	name = "пистолетный журнал Рингнека (10 мм)"
	desc = "8-раундовый журнал для пистолета Рингнека. Эти снаряды наносят умеренный урон, но борются с броней."

/obj/item/gun/ballistic/automatic/pistol/asp
	name = "БК-81 «Асп»"
	desc = "Бронебойный боевой пистолет, когда-то использовавшийся ударными командами Синдиката, теперь в основном используется потомками Gorlex Marauders. В камере 5,7 мм."

/obj/item/ammo_box/magazine/m57_39_asp
	name = "Журнал Asp (5.7x39 мм)"
	desc = "12-раундовый, двойной стек для пистолета Asp. Эти раунды наносят хороший урон со средней эффективностью против брони."

/obj/item/gun/ballistic/revolver/viper
	name = "R-23 \"Вайпер\""
	desc = "Внушительный револьвер, используемый офицерами и некоторыми агентами фракций членов Синдиката во время ICW, по-прежнему предпочитаемый капитанами и высокопоставленными офицерами бывшего Синдиката. Замкнулся в .357 Магнум."

/obj/item/gun/ballistic/revolver/viper/indie
	name = "Viper-23"
	desc = "Мощный бычий револьвер. Очень популярен среди наемников и иногда зажиточный спейсер или пират за его яркий внешний вид и мощный патрон. Замкнулся в .357 Магнум."

/obj/item/gun/ballistic/automatic/pistol/rattlesnake
	name = "MP-84 «Змеиный змей»"
	desc = "пистолет-машина, когда-то использовавшийся проникновителями Синдиката и спецназом во время МКВ. До сих пор используется специалистами бывших фракций Синдиката. Закрыто на 9 мм."

/obj/item/gun/ballistic/automatic/pistol/rattlesnake/inteq
	name = "MP-84m Kingsnake"
	desc = "пистолет-автомобиль, полученный из запасов Syndicate и слегка модифицированный до стандартов Inteq. Обычно выдается только специалистам. Закрыто на 9 мм."

/obj/item/gun/ballistic/automatic/pistol/rattlesnake/cottonmouth
	name = "MP-84m Коттонмут"
	desc = "пистолет-машина, полученный из запасов Marauder и сильно модифицированный элементами Ramzi Clique, чтобы принять больший калибр, с несколькими в значительной степени игнорируемыми недостатками 2-раундового разрыва и емкости магазина. В камере на 10 мм."

/obj/item/ammo_box/magazine/m9mm_rattlesnake
	name = "Журнал Rattlesnake (9 мм)"
	desc = "Длинный 18-раундовый двухтактный журнал, предназначенный для пистолета-пулемета Rattlesnake. Эти патроны наносят хороший урон, но борются с броней."

/obj/item/ammo_box/magazine/m10mm_cottonmouth
	name = "Журнал Cottonmouth (10 мм)"
	desc = "Длинный 14-раундовый двухтактный журнал, предназначенный для модифицированного пистолета Cottonmouth. Эти снаряды наносят умеренный урон, но борются с броней."

/obj/item/gun/ballistic/automatic/pistol/himehabu
	name = "PC-81 «Химехабу»"
	desc = "Удивительно компактный пулемет, стреляющий сверхлегкими снарядами, предназначенный для того, чтобы быть как можно меньше и скрытее, оставаясь надежной угрозой на очень близком расстоянии. проникновение брони практически отсутствует. Закрыто в .22."

/obj/item/ammo_box/magazine/m22lr_himehabu
	name = "пистолетный журнал (.22 LR)"
	desc = "Одноствольный пистолетный журнал, предназначенный для камеры .22 LR. Это довольно мало, все рассматривается."

/obj/item/gun/ballistic/automatic/smg/cobra
	name = "C-20r \"Кобра\""
	desc = "пулемет-пулемет с интегрированным супрессором, широко используемый ударными командами Синдиката во время ICW. До сих пор широко используется потомками Gorlex Marauders. Закрыто в 45."

/obj/item/gun/ballistic/automatic/smg/cobra/indie
	name = "Кобра-20"
	desc = "Старая модель пистолета-пулемета, изготовленная компанией Scarborough Arms и продаваемая наемникам, правоохранительным органам и независимым ополченцам. Он стал популярным только после окончания ICW. Закрыто в 45."

/obj/item/ammo_box/magazine/m45_cobra
	name = "Журнал Кобра (.45)"
	desc = "24-раундовый журнал для пистолета-пулемета Кобра. Эти снаряды наносят умеренный урон, но борются с броней."

/obj/item/gun/ballistic/automatic/smg/sidewinder
	name = "CDW-81 «Sidewinder»"
	desc = "Бронебойное, компактное оружие личной обороны, введенное в конце межкорпоративной войны как улучшение по сравнению с C-20r при борьбе с бронетехникой. Выпускается лишь в небольшом количестве, и используется сегодня специалистами бывших фракций Синдиката. В камере 5,7 мм."

/obj/item/ammo_box/magazine/m57_39_sidewinder
	name = "Журнал Sidewinder (5.7x39mm)"
	desc = "30-раундовый журнал для личного оборонительного оружия Sidewinder. Эти раунды наносят хороший урон со средней эффективностью против брони."

/obj/item/gun/ballistic/automatic/marksman/boomslang
	name = "МСР-90 «Бумсланг»"
	desc = "полуавтоматическая снайперская винтовка с увеличенным размахом. Компактный и способный к быстрому последующему огню без потери мощности. Используется подразделениями поддержки Синдиката и инфильтраторами во время ICW. В камере 6,5 мм CLIP."

/obj/item/gun/ballistic/automatic/marksman/boomslang/indie
	name = "Бумсланг-90"
	desc = "полуавтоматическая охотничья винтовка. Его относительная портативность и быстрый потенциал по сравнению с другими видами оружия сделали его очень популярным среди зажиточных охотников и иногда правоохранительных органов или наемников. В камере 6,5 мм CLIP."

/obj/item/ammo_box/magazine/boomslang
	name = "\improper Boomslang Magazine (6,5 мм CLIP)"
	desc = "Большой 10-раундовый магазин для снайперских винтовок Boomslang. Эти снаряды наносят удивительные повреждения и могут пробить защитное оборудование, за исключением бронетехники."

/obj/item/ammo_box/magazine/boomslang/short
	name = "\improper Boomslang Magazine (6,5 мм CLIP)"
	desc = "5-раундовый магазин для снайперских винтовок Boomslang. Эти снаряды наносят удивительные повреждения и могут пробить защитное оборудование, за исключением бронетехники."

/obj/item/gun/ballistic/automatic/marksman/taipan
	name = "AMR-83 «Тайпан»"
	desc = "Чудовищная полуавтоматическая антиматерильная винтовка, удивительно короткая для своего класса. предназначен для уничтожения мехов, легких транспортных средств и оборудования, но более чем способен уничтожить обычный персонал. Закрыто в .50 BMG."

/obj/item/gun/ballistic/automatic/assault/hydra
	name = "SMR-80 «Гидра»"
	desc = "первая модульная платформа штурмовой винтовки Scarborough Arms. Это базовая конфигурация, оптимизированная для легкого веса и удобства. Очень дорогая и редкая штурмовая винтовка. В камере 5,56 мм."

/obj/item/gun/ballistic/automatic/assault/hydra/indie
	name = "Гидра-80"
	desc = "Датированный вариант главной платформы штурмовой винтовки Scarborough Arms. принимает только небольшие журналы и запирается на полуавто. В камере 5,56 мм."

/obj/item/gun/ballistic/automatic/assault/hydra/lmg
	name = "SAW-80 «Гидра»"
	desc = "первая модульная платформа штурмовой винтовки Scarborough Arms. Этот пример выполнен в виде опорного оружия, с более тяжелыми компонентами для длительной стрельбы и большим дульным тормозом. В камере 5,56 мм."

/obj/item/gun/ballistic/automatic/assault/hydra/dmr
	name = "SBR-80 «Гидра»"
	desc = "первая модульная платформа штурмовой винтовки Scarborough Arms. Этот пример выполнен в виде стрелковой винтовки с расширенным стволом и средним зумом. Его легкий патрон компенсируется 2-раундовым взрывным действием, хотя он не может поместиться в большие расширенные магазины. В камере 5,56 мм."

/obj/item/gun/ballistic/automatic/assault/hydra/underbarrel_gl
	name = "SMR-80 «Гидра»"
	desc = "первая модульная платформа штурмовой винтовки Scarborough Arms. Это базовая конфигурация, оптимизированная для легкого веса и удобства. Очень дорогая и редкая штурмовая винтовка. У этого есть подвесной гранатомет. Закрыто в 5.56x42mm CLIP."

/obj/item/ammo_box/magazine/m556_42_hydra
	name = "Журнал штурмовой винтовки Hydra (5.56x42mm CLIP)"
	desc = "простой 30-раундовый магазин для платформы Hydra из 5,56x42 мм штурмовых винтовок CLIP. Эти снаряды наносят умеренный урон при хорошем бронепробиваемости."

/obj/item/ammo_box/magazine/m556_42_hydra/small
	name = "Короткий магазин штурмовой винтовки Hydra (5.56x42mm CLIP)"
	desc = "Короткий 20-раундовый журнал для платформы Hydra из 5,56x42 мм штурмовых винтовок CLIP; предназначен для варианта DMR. Эти снаряды наносят умеренный урон при хорошем бронепробиваемости."

/obj/item/ammo_box/magazine/m556_42_hydra/extended
	name = "расширенный магазин штурмовой винтовки Hydra (5.56x42mm CLIP)"
	desc = "Более громоздкий 60-раундовый магазин для платформы Hydra из 5,56x42 мм штурмовых винтовок CLIP. Эти снаряды наносят умеренный урон при хорошем бронепробиваемости."

/obj/item/ammo_box/magazine/m556_42_hydra/casket
	name = "шкаф магазина штурмовой винтовки Hydra (5.56x42mm CLIP)"
	desc = "Очень длинный и громоздкий 100-раундовый магазин для платформы Hydra из 5,56х42 мм штурмовых винтовок CLIP. Эти снаряды наносят умеренный урон при хорошем бронепробиваемости."

/obj/item/gun/ballistic/shotgun/automatic/bulldog
	name = "SG-60r «Бульдог»"
	desc = "Боевой дробовик-буллпап обычно виден с характерным журналом барабанов. Дико популярен среди ударных групп Синдиката во время МКВ, хотя он оказался менее полезным против военной техники. До сих пор популярен среди бывших фракций Синдиката, особенно среди пиратов Рамзи Клика. помещено в 12г."

/obj/item/gun/ballistic/shotgun/automatic/bulldog/bockadam
	name = "SG-60db «Бокадам»"
	desc = "Боевой дробовик от Marauder, который был сильно модифицирован Ramzi Clique, с распиленным стволом и двухзарядным приемником. Надежность была продана за смертельную смертность в тесных кварталах."

/obj/item/ammo_box/magazine/m12g_bulldog
	name = "журнал дробовиков (12 г бэкшота)"
	desc = "Однокомпонентный 8-раундовый журнал для дробовика Bulldog и его производных."

/obj/item/ammo_box/magazine/m12g_bulldog/drum
	name = "журнал дробовиков (12 г бэкшота)"
	desc = "Громоздкий 12-раундовый барабан, предназначенный для дробовика Bulldog и его производных."

/obj/item/gun/ballistic/shotgun/gaboon
	name = "CSG-12 «Габун»"
	desc = "Компактный дробовик, разработанный Scarborough Arms. Один из их старейших проектов все еще находится в обращении из-за их привлекательности среди тех, кто часто работает в тесных помещениях. Урезанный для максимальной портативности, механизм действия насоса делает его дико омраченным бульдогом, его более крупной современной сестрой. помещено в 12г."

/obj/item/gun/ballistic/rocketlauncher/mako
	name = "RR-86 «Мако»"
	desc = "Большая четырехтрубная ракетная установка «Мако» стреляет (относительно) небольшими ракетами, заполненными зажигательным составом, предназначенными для того, чтобы вызывать пожары и препятствовать движению противника. Способен нанести значительный ущерб экзоскелетам при ударе."

/obj/item/ammo_casing/caseless/rocket/a70mm
	name = "\improper M-KO-9HE"
	desc = "Взрывная ракета 70 мм. Огонь в мех и молитва."

/obj/item/ammo_casing/caseless/rocket/a70mm/light
	name = "\improper M-KO-9LE"
	desc = "70-миллиметровая ракета Light Explosive. Ибо, когда вы не хотите причинить слишком большой сопутствующий ущерб."

/obj/item/ammo_casing/caseless/rocket/a70mm/hedp
	name = "\improper M-KO-9HEDP"
	desc = "70-миллиметровая ракета двойного назначения. Острый конец брони."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\serene_sporting\ballistics.dm */

/obj/item/gun/ballistic/automatic/pistol/m17
	name = "Модель 17 «Микроцель»"
	desc = "Легкий и очень точный пистолет-мишень производства Serene Outdoors. Ствол может быть отвинчен для хранения. Закрыто в .22 LR."

/obj/item/ammo_box/magazine/m17
	name = "Журнал Model 17 (.22lr)"
	desc = "10-раундовый журнал для Model 17 «Micro Target». Эти патроны наносят хороший урон с ужасной эффективностью против брони."

/obj/item/gun/ballistic/automatic/pistol/m20_auto_elite
	name = "Модель 20 Auto Elite"
	desc = "Большой пистолет под патрон .44 Roumain. первоначально разработанная Serene Outdoors для департамента полиции Стар-Сити, когда их старые пистолеты оказались недостаточно мощными, Auto Elite оказалась тяжелой и громоздкой на практике. Тем не менее, он видел скромный успех в качестве оружия для крупных охотников за играми и среди клиентов, желающих произвести впечатление."

/obj/item/ammo_box/magazine/m20_auto_elite
	name = "Журнал Model 20 (.44 Roumain)"
	desc = "Девятираундовый журнал, предназначенный для пистолета Model 20. Эти патроны наносят хороший урон и лучше против брони."

/obj/item/gun/ballistic/automatic/pistol/m20_auto_elite/inteq
	name = "PO-20 Pinscher"
	desc = "Большой пистолет под патрон .44 Roumain производства Serene Outdoors. Изменены до стандартов Inteq Risk Management Group и выпущены в качестве тяжелого оружия для офицеров."

/obj/item/gun/ballistic/automatic/m12_sporter
	name = "Модель 12 «Спортёр»"
	desc = "Чрезвычайно популярная винтовка-мишень производства Serene Outdoors. Недорогой, широко доступный и производимый в огромных количествах, Sporter также популярен для охоты на мелких диких и наземных птиц. Закрыто в .22 LR."

/obj/item/ammo_box/magazine/m12_sporter
	name = "Журнал Model 12 (.22lr)"
	desc = "25-раундовый журнал для Model 12 «Sporter». Эти патроны наносят хороший урон с ужасной эффективностью против брони."

/obj/item/gun/ballistic/automatic/m12_sporter/mod
	name = "Модель 13 «Ларкер»"
	desc = "Обычная послепродажная модификация винтовки Model 12 «Sporter», оснащенная тремя выстрелами."

/obj/item/gun/ballistic/automatic/marksman/woodsman
	name = "Модель 23 Вудсман"
	desc = "Большая полуавтоматическая охотничья винтовка производства Serene Outdoors. Его мощный патрон, отличная эргономика и простота использования делают его очень популярным для охоты на крупную дичь Chambered в 8x50mmR."

/obj/item/ammo_box/magazine/m23
	name = "Журнал Model 23 (8x50mmR)"
	desc = "5-раундовый журнал для «Модели 23» Эти снаряды наносят большой урон, с отличным бронепробиваемостью."

/obj/item/gun/ballistic/automatic/m15
	name = "Модель 15 Super Sporter"
	desc = "популярная полуавтоматическая охотничья винтовка производства Serene Outdoors. Твердая универсальная производительность, высокая точность и простота доступа по сравнению с военными винтовками делают Super Sporter популярным выбором для охоты на средние дичи и иногда самообороны. Занят в 7.62x40mm CLIP."

/obj/item/ammo_box/magazine/m15
	name = "Журнал Model 15 (7.62x40mm CLIP)"
	desc = "20-раундовый журнал для Model 15 «Super Sporter». Эти снаряды наносят хороший урон при хорошей бронепробиваемости."

/obj/item/gun/ballistic/shotgun/automatic/m11
	name = "Модель 11 Бакмастер"
	desc = "полуавтоматический охотничий дробовик производства Serene Outdoors. Гораздо легче и удобнее, чем боевые дробовики, он предлагает ту же скорострельность и емкость магазина, что делает его отличным выбором для охоты на птиц и большой дичи или для сил безопасности, желающих перейти от ударных пушек. помещено в 12г."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\solar_armories\ballistic.dm */

/obj/item/gun/ballistic/automatic/powered/gauss/modelh
	name = "Модель H"
	desc = "пистолет стандартного выпуска, экспортируемый из Солярианской конфедерации. Он стреляет медленными ферромагнитными слизняками с высокой стоимостью энергии, однако они неэффективны для любой брони."

/obj/item/gun/ballistic/automatic/pistol/solgov
	name = "\improper Pistole C"
	desc = "Фаворит Терранского Регентства, презираемого солярианской бюрократией. Сместился с военной службы много веков назад, хотя по-прежнему популярен среди гражданского населения. Заперта в 5,56 мм без казея."

/obj/item/gun/ballistic/automatic/powered/gauss/claris
	name = "Клариса"
	desc = "Старинная солярианская винтовка. Заперты в ферромагнитных гранулах, как и предполагали соляриане."

/obj/item/gun/ballistic/automatic/powered/gauss/gar
	name = "Солнечный карабин GAR"
	desc = "Солярианский карабин, необычайно современный для своих производителей. Запускает ферромагнитные копья на тревожных скоростях."

/obj/item/gun/ballistic/rifle/solgov
	name = "SSG-669C"
	desc = "Снайперская винтовка, используемая солярианскими войсками. Возлюбленный своим роторным дизайном и точностью. В камере 8x58 мм без кейсов."

/obj/item/gun/ballistic/automatic/powered/gauss/rail_cannon
	name = "Модель «Atelier Railgun»"
	desc = "Высокомощный солярианский рельсотрон. Тяжелые электромагниты могут потребовать времени для калибровки перед каждым выстрелом, но мощность за каждым ферромагнитным стержнем стоит подождать."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\warra_sharplite\ballistics.dm */

/obj/item/gun/ballistic/automatic/pistol/challenger
	name = "преимущество PS9 Challenger"
	desc = "Легкий полуавтоматический 9-мм пистолет, изготовленный в основном из полимеров. Низкая цена, прощающая отдача и щедрая емкость журнала для своего класса. Закрыто на 9 мм."

/obj/item/gun/ballistic/automatic/pistol/champion
	name = "Чемпион PHB Champion"
	desc = "Большой пулеметный пистолет с впечатляющей компенсацией отдачи, что делает его значительно более стабильным и точным, чем большинство пулеметов. Закрыто на 9 мм."

/obj/item/gun/ballistic/automatic/pistol/podium
	name = "преимущество PH46 Podium"
	desc = "Тяжелый пистолет, помещенный в высокоскоростной 4,6-мм патрон, предназначенный для поражения общей бронежилетной системы. Несмотря на мощный патрон, он, как известно, удивительно управляемый, хотя и не обязательно легкий. В камере 4,6 мм."

/obj/item/gun/ballistic/automatic/pistol/podium/inteq
	name = "P46 Schnauzer"
	desc = "Модификация линейки пистолетов «подиум» Макоссо-Варры производства IRMG. Обычно выдается второй линии комбатантов за счет бронепробиваемого потенциала 4,6-мм патрона. Будьте осторожны вокруг морды. В камере 4,6 мм."

/obj/item/ammo_box/magazine/m46_30_podium
	name = "Журнал Podium (4.6x30 мм)"
	desc = "12-раундовый, двойной стек для пистолета Podium. Эти раунды наносят хороший урон со средней эффективностью против брони."

/obj/item/ammo_box/magazine/co9mm
	name = "журнал пистолета претендента (9 мм)"
	desc = "12-раундовый двухтактный журнал для пистолетов-претендентов. Это также совместимо с пистолетом-автоматом Чемпиона. Эти патроны наносят хороший урон, но борются с броней."

/obj/item/ammo_box/magazine/co9mm/hp
	name = "пистолетный журнал (9 мм HP)"
	desc = "12-раундовый двухтактный журнал для пистолетов стандартного калибра 9 мм. Эти полые точечные снаряды наносят значительный ущерб мягким целям, но почти неэффективны против бронированных."

/obj/item/ammo_box/magazine/co9mm/ap
	name = "пистолетный журнал (9mm AP)"
	desc = "12-раундовый двухтактный журнал для пистолетов стандартного калибра 9 мм. Эти бронебойные снаряды хорошо прокалывают защитное снаряжение, но теряют некоторую тормозную способность."

/obj/item/ammo_box/magazine/co9mm/rubber
	name = "пистолетный журнал (9 мм резина)"
	desc = "12-раундовый двухтактный журнал для пистолетов стандартного калибра 9 мм. Эти резиновые патроны торгуют летальностью для сильного воздействия, которое может вывести из строя цели. Еще хуже выступает против брони."

/obj/item/gun/ballistic/automatic/pistol/challenger/inteq
	name = "PS-03 Комиссар"
	desc = "Модифицированная версия PS9 Challenger, выпущенная в качестве стандарта для персонала Inteq Risk Management Group. Обладает такой же отличной управляемостью и высокой емкостью журнала, как и оригинал. Закрыто на 9 мм."

/obj/item/gun/ballistic/automatic/smg/expedition
	name = "преимущество SGL9 Expedition"
	desc = "Обманчиво легкий пистолет-пулемет. Его новая система компенсации отдачи почти исключает отдачу, а его компактные размеры хорошо подходят для использования на борту кораблей и станций."

/obj/item/ammo_box/magazine/m9mm_expedition/ap
	name = "журнал экспедиционных автоматов (9 мм AP)"
	desc = "30-раундовый журнал для пистолета-пулемета экспедиции. Эти бронебойные снаряды хорошо прокалывают защитное снаряжение, но теряют некоторую тормозную способность."

/obj/item/ammo_box/magazine/m9mm_expedition/rubber
	name = "журнал экспедиционных автоматов (9 мм резина)"
	desc = "30-раундовый журнал для пистолета-пулемета экспедиции. Эти резиновые патроны торгуют летальностью для сильного воздействия, которое может вывести из строя цели. Еще хуже выступает против брони."

/obj/item/gun/ballistic/automatic/smg/resolution
	name = "\improper Advantage PD46 Resolution"
	desc = "Удивительно компактное 4,6-мм личное оружие защиты с очень необычной конструкцией. Несмотря на некоторую неловкость в перезарядке, PD46 обладает отличной эргономикой стрельбы и отличной точностью для своего класса, в сочетании с бронепробиваемым патроном и низкой ценой входа."

/obj/item/gun/ballistic/automatic/smg/resolution/inteq
	name = "\improper БДМ-50 Акита"
	desc = "преимущество PD46, измененное в соответствии с требованиями и стандартами Inteq. Неудобно перезаряжаться, хотя имеет мощный патрон с хорошей эргономикой и точностью."

/obj/item/gun/ballistic/shotgun/automatic/negotiator
	name = "переговорщик AST12"
	desc = "пушка с двойной трубкой, которая позволяет пользователю переключаться между двумя типами боеприпасов по требованию или просто удвоить имеющиеся боеприпасы."

/* C:\Shiptest\code\modules\projectiles\guns\manufacturer\warra_sharplite\lasers.dm */

/obj/item/gun/energy/sharplite
	name = "острая лазерная пушка"
	desc = "Новейшие из острых! «помогите, если увидите это!» Вау! Немного разочарования, которое вы чувствуете."

/obj/item/gun/energy/sharplite/ohm
	name = "SL X26 «Ohm» — пистолет с переменной энергией"
	desc = "Компактный энергетический пистолет, который может стрелять смертельными электроплазменными болтами или выносливыми отключающими болтами."

/obj/item/gun/energy/sharplite/yari
	name = "SL X01 «Yari» Тяжелый изменяемый пистолет"
	desc = "Громоздкий пистолет, который может стрелять разрушительными электроплазменными болтами и выстрелами отключателя. Ранний продукт Sharplite, отличающийся необычайно сильной мощностью."

/obj/item/gun/energy/sharplite/yari/brazil
	name = "модифицированная старая лазерная пушка"
	desc = "Он каким-то образом модифицирован, чтобы иметь больше огневых мод."

/obj/item/gun/energy/sharplite/rush
	name = "L305 «Rush» Tactical Plasma Gun"
	desc = "Радикальная разработка на раме X26, оснащенной плазменной камерой быстрого цикла и предназначенной для производства устойчивых всплесков электроплазменных болтов малой мощности."

/obj/item/gun/energy/sharplite/surge
	name = "SL L201 «Surge» плазменная винтовка Marksman"
	desc = "Длинная винтовочная электроплазменная пушка. Специализируется на дальней стрельбе, с расширенной фокусирующей сборкой, которая производит гораздо более высокие скорости снаряда и более мощные болты за счет использования мощности."

/obj/item/gun/energy/sharplite/surge/resistor
	name = "SL L204 «Resistor» плазменная винтовка"
	desc = "Ружейная, полуавтоматическая электроплазменная пушка. Это конденсатор с высокой мощностью дает резистору значительный удар по сравнению с его сверстниками, но потребляет гораздо больше энергии."

/obj/item/gun/energy/sharplite/volt
	name = "SL X12 «Volt» переменный энергетический карабин"
	desc = "Короткий, несколько тяжелый карабин, который может стрелять электроплазмой или отключающими болтами. популярный с деталями безопасности с заданиями с низкой угрозой."

/obj/item/gun/energy/sharplite/volt/inteq
	name = "PP10 «Кадехо» Энергетический карабин"
	desc = "Sharplite X12 VEC доработан в цветах Inteq Risk Management Group. Как и базовая модель, она запускает смертельные электроплазмы или нелетальные болты-отключатели. Модификации в основном косметические."

/obj/item/gun/energy/sharplite/amperage
	name = "\improper SL X46 “Amperage” Variable Energy Blaster"
	desc = "Тяжелое, громоздкое оружие, предназначенное для стрельбы несколькими электроплазмами или отключающими болтами, в отличие от баллистического дробовика. Скорость электроплазмы имеет тенденцию уменьшать распространение и увеличивать эффективный диапазон по сравнению с обычными баллистическими дробовиками."

/obj/item/gun/energy/sharplite/amperage/zeta
	name = "\improper SL X-45"
	desc = "Очень старый X-46, у него нет запаса или большого украшения, и он из прошлого. привет! Что это за экран рядом с кнопкой выбора режима?"

/obj/item/gun/energy/sharplite/hades
	name = "SL AL655 «Hades» штурмовая плазменная винтовка"
	desc = "Мощная электроплазменная пушка с быстрым ретранслятором и множеством конденсаторов. APR быстро запускает тяжелые электроплазменные болты."

/obj/item/gun/energy/sharplite/hades/inteq
	name = "PP20 «Баргест» АТР"
	desc = "Штурмовая плазменная винтовка Sharplite была переработана в цветах Inteq Risk Management Group. Мощное оружие, которое может доставлять быстрые огневые, бронепробиваемые электроплазменные болты."

/obj/item/gun/energy/sharplite/sarissa
	name = "плазменный ускоритель SL AL607 «Sarissa»"
	desc = "Тяжелая электроплазменная винтовка с обширной сборкой ускорителя, общая длина которой почти сопоставима со средней высотой Кепори. производит единичные электроплазменные болты впечатляющей мощности и скорости, которые ударяют с достаточной силой и точностью, чтобы подавить большинство пехотных защит."

