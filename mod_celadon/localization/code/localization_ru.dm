/mob/living/simple_animal/hostile/human/hermit/survivor
	name = "Странник-отшельник"
	desc = "Фигура с дикими глазами, в потрепанном горном оборудовании и с деформированным телом, скрученным тяжелыми металлами и высоким фоновым излучением песчаных миров."

/mob/living/simple_animal/hostile/human/hermit/survivor/passive
	name = "Деревенский отшельник"
	desc = "Запаниковавшая, дикая фигура, одетая в потрепанное горное оборудование и застывшая в страхе. Они относятся к вам с осторожностью, сжимаясь, чтобы вас не видели."

/mob/living/simple_animal/hostile/human/hermit/survivor/lunatic
	name = "Отшельник лунатик"
	desc = "Фигура с дикими глазами, облаченная в потрепанное горное оборудование с пластиковым стулом. Они двигаются беспорядочно, глаза лихорадочно дрожат."

/mob/living/simple_animal/hostile/human/hermit/survivor/brawler
	name = "Отшельник Браулер"
	desc = "позиционированная фигура, укрытая за дрянным, импровизированным деревянным бакером. Зазубренный мачете держится в их сцеплении."

/mob/living/simple_animal/hostile/human/hermit/ranged/hunter
	name = "Отшельник Хантер"
	desc = "Фигура с дикими глазами. Осторожно, у него есть винтовка, и он помнит достаточно своей старой жизни, чтобы использовать ее!"

/mob/living/simple_animal/hostile/human/hermit/ranged/shotgun
	name = "преследователь отшельника"
	desc = "Фигура с дикими глазами, владеющая самодельным дробовиком. Выражение через их облачный козырек свирепое, и они готовы к спринту."

/mob/living/simple_animal/hostile/human/hermit/ranged/gunslinger
	name = "Отшельник Солдат"
	desc = "Восстание шахтера, хотя в основном под землей, получило несколько хороших поставок оружия из внесекторального источника. Возможно, вам стоит начать бегать."

/mob/living/simple_animal/hostile/human/hermit/ranged/energy
	name = "Отшельник"
	desc = "Качественное оружие трудно достать в песчаных мирах, что заставляет многих выживших импровизировать с тем, что у них есть. Он надеется, что E-11 спасет ему жизнь."

/mob/living/simple_animal/hostile/human/hermit/ranged/energy/volt
	name = "Отшельник Милитаман"
	desc = "Несмотря на суровые условия, этот отшельник обладает блестящим, ухоженным карабином Шарплита. Они крепко держатся за него, как за ценное владение."

/mob/living/simple_animal/hostile/human/hermit/ranged/energy/rush
	name = "Эрмит Брокер"
	desc = "Этот отшельник держит блестящий, хорошо сохранившийся пистолет-пулемет Шарплита. Уверенность в своем движении как предупреждение, так и хвастовство, они умеют им пользоваться!"

/mob/living/simple_animal/hostile/human/hermit/ranged/energy/sarissa
	name = "Отшельник Шарпшутер"
	desc = "С дисциплиной, впечатляющей для обычно дезорганизованных отшельников, эта винтовка имеет блестящую хромированную винтовку Шарплита - почти до тех пор, пока они высоки - и они тренируются в этот момент!"

/mob/living/simple_animal/hostile/human/hermit/ranged/tesla_rifle
	name = "Охранник-отшельник"
	desc = "В пустыне фронтира отчаяние может легко стать инновацией. Этот отшельник владеет продуктом таких предприятий. Электрический треск и готовая к рычанию винтовка."

/mob/living/simple_animal/hostile/human/hermit/mayor
	name = "Мэр города"
	desc = "Кроваво-красный силуэт, выравнивающий злую боевую винтовку в вашем направлении. Их костюм изношен и поврежден, но все еще бронирован. Их позиция тренирована и насторожена, в отличие от многих блуждающих поблизости."

