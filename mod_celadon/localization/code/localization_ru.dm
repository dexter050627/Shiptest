/mob/living/simple_animal/hostile/asteroid/elite/legionnairehead
	name = "глава легионера"
	desc = "Голова легионера плавает сама по себе. Не следует подходить слишком близко, хотя, как только он увидит вас, у вас действительно не будет выбора."

/obj/structure/legionnaire_bonfire
