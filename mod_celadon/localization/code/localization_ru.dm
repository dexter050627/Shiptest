/obj/item/clothing/glasses/hud/spacecop
	name = "полицейские авиаторы"
	desc = "За то, что ты считаешь себя крутой, когда жестоко обращаешься с протестующими и меньшинствами."

/obj/item/clothing/glasses/hud/health/prescription
	name = "медицинский сканер HUD"
	desc = "Дисплей, который сканирует гуманоидов и предоставляет точные данные об их состоянии здоровья. Эта пара также помогает близоруким врачам."

/obj/item/clothing/glasses/hud/security/prescription
