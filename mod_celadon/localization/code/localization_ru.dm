/obj/structure/sign/poster/official/safety_internals
	name = "Безопасность: внутренние"
	desc = "плакат, предписывающий зрителю носить внутренности в редких условиях, где нет кислорода или воздуха, стал токсичным."

/obj/structure/sign/poster/official/safety_eye_protection
	name = "Безопасность: защита глаз"
	desc = "плакат, предписывающий зрителю носить защиту глаз при работе с химическими веществами, дымом или яркими огнями."

/obj/structure/sign/poster/official/safety_report
	name = "Безопасность: доклад"
