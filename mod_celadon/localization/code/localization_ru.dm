	desc = "пальто из твердой кожи. предназначен для выдерживания длительных охот в суровой пустыне."

/obj/item/clothing/suit/armor/roumain/shadow
	name = "сен-румен тень пылесос"
	desc = "пальто из твердой кожи. Его грубая, едва обработанная отделка типична для одного из стажеров ополчения Сен-Румена."

/obj/item/clothing/suit/toggle/labcoat/roumain_med
	name = "медицинский пылесос saint-roumain"
	desc = "пальто из твердой кожи и дополнительно обработано экзотическими стерилизующими маслами и воском. Лечение и его более закрытая конструкция обеспечивают гораздо лучшую защиту от биологических опасностей."

/obj/item/clothing/suit/hazardvest/roumain
	name = "кожаный жилет saint-roumain"
	desc = "Модифицированный кожаный пылесос Roumain с его большими закрылками и рукавами отрезан, чтобы обеспечить дополнительную мобильность при обслуживании оружия и судов, принадлежащих церкви Святого Румена. Его специальная обработка обеспечивает лучшую защиту от кислоты и огня."

/obj/item/clothing/suit/armor/roumain/flamebearer
	name = "одежда огненосца saint-roumain"
	desc = "Набор пепельно-серых халатов из твердой кожи, украшенных золотыми отделками. Его грубое завершение после почти обаяния и применения ароматических веществ в значительной степени благоприятствует церковной секте церкви Святого Румена, живому напоминанию о самом Ашене Хантсмане."

/obj/item/clothing/suit/armor/roumain/plate
	name = "тяжелая пыльца saint-roumain"
	desc = "Тонкий кузнечный нагрудник, поставленный над толстым пальто. Обеспечивает защиту груди выше среднего для любых охотников, которые ее надевают. при этом защитный, благодаря своему составу, довольно громоздкий."

/obj/item/clothing/suit/armor/roumain/plate/montagne
	name = "сен-румен монтанское боевое пальто"
	desc = "Тонкий камуфляж, положенный над богато украшенным пальто. Этот вид боевого пальто обычно носят более неортодоксальные монтагни или те, которые сталкиваются с более сильными врагами."

/obj/item/clothing/suit/armor/roumain/colligne
	name = "пальто saint-roumain colligne"
	desc = "Хорошо сохранившееся твердое кожаное пальто, как правило, носят для обозначения ранга Коллинь, стажер Хантер Монтань. Он обрабатывается пуленепробиваемыми материалами и облицован темным мехом ужасных волков."

/obj/item/clothing/suit/armor/roumain/montagne
	name = "сен-румэнский монтажный пальто"
	desc = "Стильное красное пальто, указывающее на то, что вы, по сути, Охотник Монтань. Изготовлена из экстра твердой экзотической кожи, обработана пуленепробиваемыми материалами и облицована мехом какого-то неопознаваемого существа."

/obj/item/clothing/suit/armor/roumain/plate/medium
	name = "Три четверти харизма"
	desc = "Изысканно разработанная грудная пластина рядом с большой защитной плечевой пластиной и кисточками для защиты ног пользователя. Одно плечо остается открытым, чтобы позволить румейнистам выровнять оружие и прицелиться. Обеспечивает защиту груди и конечностей выше среднего за счет мобильности."

/obj/item/clothing/suit/armor/roumain/plate/heavy
	name = "Тяжелая трехквартальная плита Harness"
	desc = "Мастерски сделанный нагрудник наряду с тяжелыми кисточками и плесенями обеспечивает пользователю более чем достаточную защиту от стрельбы и зверя. Его угловая конструкция обеспечивает более высокую общую защиту. Несмотря на громоздкость, он обеспечивает беспрецедентную защиту, зарезервированную только для очень опасных охот."

/obj/item/clothing/head/helmet/space/hardsuit/mining/roumain
	name = "\improper шлем охотника за руменами"
	desc = "Бронированный шлем, напоминающий традиционный салат, изготовленный Hunter’s Pride. Несмотря на то, что он напоминает доиндустриальную солярианскую броню, он удивительно вакуумный."

/obj/item/clothing/suit/space/hardsuit/mining/roumain
	name = "\improper roumain hunter's hardsuit"
	desc = "Ручной костюм из доспехов Hunter's Pride, с заметно тяжелой пластиной. Такая сталь, по-видимому, хорошо противостоит тупым и резким атакам и достаточно толстая, чтобы блокировать огонь из стрелкового оружия. Несмотря на то, что он кажется древним, он заслуживает внимания."

/obj/item/clothing/head/helmet/space/hardsuit/solgov/roumain
	name = "\improper roumain hardsuit helmet"
	desc = "Бронированный шлем с необычным дизайном, который напоминает как доиндустриальную солярианскую броню, так и иконографию, изображающую Ашена Хантсмана. Несмотря на ручную работу, она на удивление вполне пригодна для использования в космосе."

/obj/item/clothing/suit/space/hardsuit/security/roumain/elite
	name = "Raskas Combat Hardsuit (альбом)"
	desc = "Дотошно и тщательно кузнечная броня из Hunter's Pride, которая несет тяжелую, единую унифицированную угловую пластину для защиты основного корпуса с заметно более тяжелой броней на конечностях. В то время как хорошо оцененный против зверей, пуль и вакуума пространства, этот костюм специально предназначен для борьбы с врагами, вооруженными винтовками вместо когтей."

/obj/item/clothing/head/helmet/space/hardsuit/security/roumain/elite
	name = "Raska Fight Hardsuit Шлем"
	desc = "Большой шлем в стиле салата, изготовленный Hunter's Pride. Легкие сплавы, используемые в его конструкции, позволяют безопасно и комфортно использовать в вакууме. Увенчанный безупречным гребнем из декоративных перьев, этот шлем является свидетельством руменистского мастерства."

/obj/item/clothing/head/cowboy/sec/roumain
	name = "шляпа охотника"
	desc = "причудливая шляпа с красивым пером. То, как он покрывает ваши глаза, заставляет вас чувствовать себя задирой."

/obj/item/clothing/head/cowboy/sec/roumain/shadow
	name = "шляпа теней"
	desc = "Грубая, простая шляпа. То, как он покрывает ваши глаза, заставляет вас чувствовать себя круто, но вы просто похожи на охотника за подражателями."

/obj/item/clothing/head/cowboy/sec/roumain/machinist
	name = "шляпа машиниста"
	desc = "Маленькая, скромная кожаная шляпа. Это дает вам грызущее желание создать классические гизмосы и губеры или, в качестве альтернативы, устранить любые нарушения в вашем сосуде."

/obj/item/clothing/head/cowboy/sec/roumain/med
	name = "шляпа медицинского охотника"
	desc = "Очень широкополая круглая шляпа, обработанная маслом и воском. Каким-то образом удается выглядеть стильно и жутко одновременно."

/obj/item/clothing/head/cowboy/sec/roumain/flamebearer
	name = "шляпа пожарного"
	desc = "Широкополая остроконечная шляпа с обугленной кожей, придающая ей пепельно-серый вид. Дизайн почитает тот, который носил сам Ашен Хантсман, согласно легенде."

/obj/item/clothing/head/cowboy/sec/roumain/colligne
	name = "шляпа коллиньи"
	desc = "причудливая, остроконечная кожаная шляпа с большим перьевым шлейфом, чтобы сигнализировать, что вы на самом деле... Охотник Коллин. У вас еще есть несколько способов, прежде чем вы получите титул Монтань."

/obj/item/clothing/head/cowboy/sec/roumain/montagne
	name = "шляпа монтанье"
	desc = "Очень причудливая шляпа с большим перьевым шлейфом, чтобы сигнализировать, что вы, на самом деле, Охотник Монтань. Экзотическая меховая подкладка безупречно мягкая."

/obj/item/clothing/head/helmet/roumain
	name = "чайник охотника"
	desc = "Компрессор, изготовленный SRM, обычно носится только тогда, когда защита головы абсолютно необходима."

