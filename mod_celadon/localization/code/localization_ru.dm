/obj/structure/sign/poster/bay/bay_39
	name = "Ответственные привычки медбей No 91"
	desc = "плакат безопасности с химиком, держащим флакон. Всегда носите защитное снаряжение при работе с опасными химическими веществами, даже если это касается только небольших количеств"

/obj/structure/sign/poster/bay/bay_40
	name = "Согласованная рабочая среда"
	desc = "На этом плакате изображена молодая женщина в стильном платье. Старайтесь стремиться к приятной атмосфере в рабочем пространстве. Дружелюбное слово может сделать больше, чем формы в трипликате"

/obj/structure/sign/poster/bay/bay_41
	name = "профессиональная рабочая среда"
	desc = "плакат безопасности с зеленой волосатой женщиной в мерцающем синем платье. \ Как агент по внутренним делам, ваша работа заключается в том, чтобы создать справедливую и приятную рабочую среду для членов экипажа, насколько это возможно"

/obj/structure/sign/poster/bay/bay_42
	name = "Инженерный пинок"
	desc = "Это пин-ап плакат. полуголая девушка с белыми волосами, тонированными мышцами и потрясающими голубыми глазами смотрит на вас с плаката. Ее сварочный шлем, татуировки и серый комбинезон, висящий вокруг ее талии, придает немного прочное ощущение."

/obj/structure/sign/poster/bay/bay_43
	name = "Ответственные привычки медбей, No 3"
	desc = "плакат безопасности с фиолетовым хирургом. Она выглядит немного поперек. пусть хирурги делают свою работу. НИКОГДА не заменяйте и не удаляйте хирургический инструмент с того места, куда его положил хирург"

/obj/structure/sign/poster/bay/bay_44
	name = "Время выпить?"
	desc = "На этом плакате изображен дружелюбно выглядящий таджаран, держащий поднос с напитками."

/obj/structure/sign/poster/bay/bay_45
	name = "Ответственные инженерные привычки No1"
	desc = "плакат безопасности с голубоволосым инженером. при ремонте машины или конструкции всегда стремитесь к долгосрочным решениям"

/obj/structure/sign/poster/bay/bay_46
	name = "Вдохновенный юрист"
	desc = "Вдохновляющий плакат с изображением скреллианского адвоката. Кажется, он что-то кричит, яростно указывая направо."

/obj/structure/sign/poster/bay/bay_47
	name = "Щелчок безопасности"
	desc = "Это пин-ап плакат. Темнокожая беловолосая девушка позирует на солнечном свете, надев крышку резервуара с открытым желудком. Текст на плакате гласит «М, Суккуб безопасности» и помада окрашивает верхний правый угол, как будто поцелованная самой моделью."

/obj/structure/sign/poster/bay/bay_48
	name = "Борг пинап?"
	desc = "Это плакат с пин-ап? Это диаграмма на старой модели киборга с запиской, начертанной в маркере внизу, наверху есть большой XO, написанный красным маркером."

/obj/structure/sign/poster/bay/bay_49
	name = "Набор инженерных кадров"
	desc = "Это плакат, показывающий инженера, расслабляющегося за компьютером, — говорится в тексте. присоединяйтесь к инжинирингу сегодня"

/obj/structure/sign/poster/bay/bay_50
	name = "Девушка-пинап Синди Кейт"
	desc = "Особенно это касается Синди Кейт, соблазнительной исполнительницы, хорошо известной среди менее проницательных кругов."

/obj/structure/sign/poster/bay/bay_51
	name = "космический плакат"
	desc = "Это плакат, выпущенный компанией Generic Space Company в рамках серии памятных плакатов о чудесах космоса. Один из трех."

/obj/structure/sign/poster/bay/bay_52
	name = "плакат пожарной безопасности"
	desc = "Это плакат, напоминающий вам о том, что вы должны делать, если вы в огне или на танцевальной вечеринке."

/obj/structure/sign/poster/bay/bay_53
	name = "плакат огнетушителя"
	desc = "Это плакат, напоминающий вам о том, что вы должны использовать, чтобы потушить огонь."

/obj/structure/sign/poster/bay/bay_54
	name = "плакат пожарного"
	desc = "Это плакат особо строго выглядящего пожарного. подпись гласит: «Только вы можете предотвратить космические пожары»"

/obj/structure/sign/poster/bay/bay_55
	name = "постер оценки Земли"
	desc = "Это плакат, выпущенный компанией Generic Space Company в рамках серии памятных плакатов о чудесах космоса. Два из трех."

/obj/structure/sign/poster/bay/bay_56
	name = "постер оценки Марса"
	desc = "Это плакат, выпущенный компанией Generic Space Company в рамках серии памятных плакатов о чудесах космоса. Три из трех."

/obj/structure/sign/poster/bay/bay_57
	name = "космический карп предупреждающий плакат"
	desc = "Этот плакат рассказывает об опасности инвазии космических карпов."

/obj/structure/sign/poster/bay/bay_58
	name = "информационный плакат space carp"
	desc = "Этот плакат демонстрирует старую поговорку об опасностях космического карпа-мигранта."

/obj/structure/sign/poster/pol/pol_1
	name = "Безопасность!"
	desc = "плакат, советующий вам научиться надевать свои внутренние органы в любой момент."

/obj/structure/sign/poster/pol/pol_2
	name = "Безопасность!"
	desc = "Голубой и белый плакат. Это советует вам носить защитные очки при обращении с химическими веществами."

/obj/structure/sign/poster/pol/pol_3
	name = "Безопасность!"
	desc = "постер безопасности, инструктирующий вас соблюдать требования властей, особенно в чрезвычайной ситуации."

/obj/structure/sign/poster/pol/pol_4
	name = "Чистые руки спасают жизни"
