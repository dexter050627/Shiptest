/obj/item/garnish/umbrellablue
	name = "синий зонтик для напитков"
	desc = "Маленький зонтик, чтобы выпить. Этот синий."

/obj/item/garnish/umbrellagreen
	name = "зеленый зонтик"
	desc = "Маленький зонтик, чтобы выпить. Этот зеленый."

/obj/item/garnish/straw
	name = "бумажная солома"
	desc = "Бумажная соломинка предназначена для использования с напитками."

/obj/item/garnish/stripedstraw
	name = "красная полосатая бумажная солома"
