	desc = "Вишнево-красная шапка с белым логотипом «VI», вышитым на лицевой стороне. Выдается охранникам Вигилиты как повседневная одежда и рабочая одежда с низким уровнем угрозы. Удивительно прочный и очень популярный среди нынешних и отставных сотрудников."

/obj/item/clothing/head/helmet/m10/nanotrasen
	name = "\improper Vigilitas Helmet"
	desc = "Классический защитный шлем, используемый Vigilitas, с использованием шлема M-10 с их цветовой гаммой!"

/obj/item/clothing/head/helmet/bulletproof/x11/nanotrasen
	name = "\improper Bulletproof Vigilitas Helmet"
	desc = "Массивный пуленепробиваемый шлем в модели X-11, используемый Vigilitas и NT для предотвращения потерь!"

/obj/item/clothing/head/helmet/bulletproof/x11/nanotrasen/sechud
	name = "Vigilitas Visor Шлем"
	desc = "Широко известный шлем среди низших и средних чинов частных сил безопасности Vigilitas Interstellar. Обеспечивает достойную защиту от наиболее распространенных угроз и имеет встроенную защитную панель. Красная полоса напоминает о чем-то..."

/obj/item/clothing/head/helmet/riot/nanotrasen
	name = "\improper Vigilitas Riot Helmet"
	desc = "Стойкий шлем для охраны в Вигилитасе, часто используемый для подавления бунтовщиков на корпоративных площадках."

/obj/item/clothing/head/nanotrasen/cap/supply
	name = "коричневый softcap"
	desc = "Коричневая кепка с логотипом N+S Logistics на лицевой стороне. Выдается практически каждому сотруднику N+S, хотя его износ является необязательным."

/obj/item/clothing/head/nanotrasen/cap/janitor
	name = "фиолетовый софткап"
	desc = "Богатая фиолетовая мягкая шапка с логотипом Nanotrasen на лицевой стороне. по какой-то причине этот своеобразный оттенок фиолетового используется только персоналом, а не Nanotrasen Blue. Он уже слегка запятнан."

/obj/item/clothing/head/nanotrasen/cap/medical
	name = "синий медицинский softcap"
	desc = "Мягкая кепка в мягком DeForest Blue с большим белым крестом на передней части, обозначающим владельца как обученного медицинского работника. Ношение этого без медицинской подготовки является нарушением руководящих принципов сотрудников Nanotrasen Corporation."

/obj/item/clothing/head/nanotrasen/officer
	name = "офицерская шляпа"
	desc = "Синая пиковая шляпа с красным шелковым украшением и вышитым логотипом Nanotrasen, которую носило исключительно руководство."

/obj/item/clothing/head/nanotrasen/officer/fedora
	name = "офицерская федора"
	desc = "Федора в бурном оттенке Nanotrasen Blue, с красной шелковой полосой."

/obj/item/clothing/head/nanotrasen/captain
	name = "широкая шляпа капитана"
	desc = "Хорошо быть королем."

/obj/item/clothing/head/nanotrasen/captain/peaked
	name = "капитанская кепка"
	desc = "Украшенная синяя пиковая кепка, изобилующая лаврами и золотой нитью, с большим значком на передней панели с логотипом Nanotrasen Corporation. Эта шляпа практически сочит авторитет."

/obj/item/clothing/head/hardhat/nanotrasen/blue
	name = "синяя сверхмощная шляпа"
	desc = "Жесткий пластиковый шлем с подвеской, предназначенный для защиты от тупых ударов. Этот ярко окрашен в Nanotrasen Blue, с логотипом компании на лицевой стороне."

/obj/item/clothing/head/hardhat/nanotrasen/yellow
	name = "желтая сверхпрочная шляпа"
	desc = "Жесткий пластиковый шлем с подвеской, предназначенный для защиты от тупых ударов. Это ярко-желтый цвет, жутко напоминающий общий желтый хардхат. Недвижимость компании Nakamura Engineering."

/obj/item/clothing/head/hardhat/nanotrasen/white
	name = "белая тяжёлая шляпа"
	desc = "Чрезвычайно жесткий пластиковый шлем с подвеской, предназначенный для защиты от тупых ударов. Этот цвет ярко-белый, типичный для управленческого персонала, и имеет логотип Nakamura Engineering."

/obj/item/clothing/head/beret/centcom_formal
	name = "Официальный сайт CentCom Formal Beret"
	desc = "Иногда необходимо найти компромисс между модой и обороной. Благодаря последним улучшениям прочности нанофабрики Nanotrasen, на этот раз это не так."

/* C:\Shiptest\mod_celadon\outfit\code\nanotrasen\clothing\mask.dm */

/obj/item/clothing/mask/gas/vigilitas
	name = "противогаз Vigilitas"
	desc = "Защитный противогаз, предназначенный для первого реагирования, специальных операций и борьбы с терроризмом офицерами «Вигилитас Интерстеллар». Он имеет широкий устойчивый к царапинам козырь, порты для подключения подачи кислорода и безопасные, удобные ремни."

