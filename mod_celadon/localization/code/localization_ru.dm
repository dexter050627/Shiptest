/obj/item/clothing/suit/nanotrasen/medical_smock
	name = "хирургический смок"
	desc = "Толстый отталкивающий жидкость смок, сделанный в том, что безошибочно Nanotrasen Blue. Тег на внутренней стороне декларирует его собственность медицинской компании DeForest."

/obj/item/clothing/suit/nanotrasen/suitjacket
	name = "причудливый черный пиджак"
	desc = "прекрасная черная льняная куртка с синей маркировкой и лацканом Nanotrasen. У него странная угрожающая аура."

/obj/item/clothing/suit/nanotrasen/vest
	name = "черный жилет опасности"
	desc = "Тонкий черный жилет с отражающей маркировкой, надеваемый для обеспечения видимости при работе вокруг промышленного оборудования или в темных или пыльных условиях. Недвижимость компании N+S Logistics."

/obj/item/clothing/suit/nanotrasen/vest/yellow
	name = "жёлтый жилет опасности"
	desc = "Тонкий желтый жилет с отражающей маркировкой, надеваемый для обеспечения видимости при работе вокруг промышленного оборудования. Недвижимость компании Nakamura Engineering."

/obj/item/clothing/suit/nanotrasen/vest/blue
	name = "голубой жилет опасности"
	desc = "Тонкий жилет с отражающими полосами, надеваемый для обеспечения видимости в опасных условиях. Сам жилет представляет собой оскорбительно яркий оттенок Nanotrasen Blue. Собственность Нанотрасенского атмосферного корпуса."

/obj/item/clothing/suit/toggle/nanotrasen
	name = "офицерское пальто"
	desc = "Умная синяя униформа с красными шелковыми акцентами и большая пряжка с выгравированным логотипом Nanotrasen. Стандартная одежда для командиров на борту кораблей Nanotrasen."

/obj/item/clothing/suit/toggle/labcoat/nanotrasen
	name = "корпоративный плащ"
	desc = "Стандартизированный белый плащ, используемый медицинским и научным персоналом, связанным с Нанотрасеном. Упрощенный логотип Nanotrasen сшито на лицевой стороне."

/obj/item/clothing/suit/toggle/labcoat/nanotrasen/blue
	name = "лабкоат медицинского директора"
	desc = "Хорошо сделанный, установленный плащ, изготовленный из высококачественных материалов и спортивных синих отметин вокруг рук и подола. Логотип DeForest Medical аккуратно вышит на лицевой стороне. Стильный, практичный и исключительно профессиональный."

/obj/item/clothing/suit/toggle/labcoat/nanotrasen/black
	name = "лабкоат директора по науке"
	desc = "перепроектированный и довольно пугающий черный халат с очень высоким воротником, столь же непроницаемый для лабораторных опасностей, как и без костюма для всего тела. Логотип Nanotrasen гордо украшен на груди."

/obj/item/clothing/suit/toggle/labcoat/nanotrasen/paramedic
	name = "яркая голубая куртка фельдшера"
	desc = "Толстая защитная синяя куртка с отражающими полосами видимости и логотипом DeForest Medical, вшитым в грудь. Безопасен от всех видов царапин и брызг."

/obj/item/clothing/suit/toggle/chorejacket/nanotrasen
	name = "поставка куртки"
	desc = "Свободная облегающая куртка, предназначенная для работников N+S Logistics, с глубокими карманами и большими кнопками, обеспечивающими легкий доступ в условиях работы."

/obj/item/clothing/under/nanotrasen/supply/qm
	name = "директор по снабжению"
	desc = "Хрустящие брюки и коричневая рубашка, которыми может гордиться любой директор по снабжению. Эмблема N+S Logistics с розовым компасом выгравирована на каждой кнопке."

/obj/item/clothing/suit/armor/nanotrasen
	name = "бронежилет"
	desc = "прочный жилет, предназначенный для защиты сотрудников Vigilitas Interstellar от различных основных угроз. Спортивная красная полоса спереди."

/obj/item/clothing/suit/armor/nanotrasen/sec_director
	name = "пальто директора службы безопасности"
	desc = "Специальное черное пальто, изготовленное из передовых баллистических тканей и композитов. Логотип Vigilitas «VI» выбит на каждой кнопке. Устрашающе и глубоко стильно."

/obj/item/clothing/suit/armor/nanotrasen/captain
	name = "капитанская куртка"
	desc = "прочная куртка в Nanotrasen Blue, подчеркнутая золотой нитью и облицованная слоем баллистической ткани. Его большая блестящая пряжка на поясе украшена фирменным логотипом Nanotrasen."

/obj/item/clothing/suit/armor/nanotrasen/captain/parade
	name = "показная капитанская куртка"
	desc = "прекрасная синяя куртка с изысканным декором, подходящая для особых формальных ситуаций, или для командира, который хочет выставить напоказ свой статус даже больше, чем обычно. Богато украшен золотой нитью и вышитыми логотипами Nanotrasen."

/obj/item/clothing/suit/hooded/wintercoat/centcom
	name = "зимнее пальто centcom"
	desc = "Роскошное зимнее пальто, сплетенное в ярко-зеленых и золотых цветах Центрального командования. Он имеет небольшой штифт в форме логотипа Nanotrasen для молнии."

/obj/item/clothing/suit/hooded/explorer
	name = "исследовательский костюм"
	desc = "Легкий, бронированный мягкий костюм, предназначенный для исследования опасных планетарных окружений. Дизайн Nanotrasen по происхождению, позже присвоенный EXOCOM для массового розничного производства."

/* C:\Shiptest\mod_celadon\outfit\code\nanotrasen\clothing\uniforms.dm */

/obj/item/clothing/under/nanotrasen
	name = "униформа палубника"
	desc = "простая серая рабочая форма с логотипом Nanotrasen Corporation, вышитым на лицевой стороне. Типичный для сотрудников начального уровня."

/obj/item/clothing/under/nanotrasen/engineering
	name = "инженерный комбинезон"
	desc = "Грязный серый комбинезон с отражающими желтыми вспышками на конечностях и значком гаечного ключа на спине. Небольшой фирменный логотип Nakamura Engineering вшивается в ошейник."

/obj/item/clothing/under/nanotrasen/engineering/atmos
	name = "атмосферный комбинезон"
	desc = "Толстый серый комбинезон с черными полосами и значком «O2» на спине. Небольшая эмблема Nanotrasen Atmospheric Corps вместе с логотипом Nakamura Engineering вшивается в воротник."

/obj/item/clothing/under/nanotrasen/engineering/director
	name = "костюмы инженерного директора"
	desc = "Толстый черный комбинезон над желтой офисной рубашкой. В отличие от большинства управленческих сотрудников, директорам Nakamura Engineering по-прежнему необходимо иметь дело с их работой."

/obj/item/clothing/under/nanotrasen/supply
	name = "шорты грузоотправителя"
	desc = "Дешевая рабочая рубашка и черные шорты, типичные для грузоперевозчиков и клерков в N+S Logistics."

/obj/item/clothing/under/nanotrasen/supply/qm
	name = "директор по снабжению"
	desc = "Хрустящие брюки и коричневая рубашка, которыми может гордиться любой директор по снабжению. Эмблема N+S Logistics с розовым компасом выгравирована на каждой кнопке."

/obj/item/clothing/under/nanotrasen/supply/miner
	name = "комбинезоны для майнинга"
	desc = "Дешевые коричневые комбинезоны над серым комбинезоном, уже слегка потрепанные и насыщенные каменной пылью. N+S Логотипы логистики заметно сшиты в нескольких местах."

/obj/item/clothing/under/nanotrasen/science
	name = "наука ослабевает"
	desc = "Толстая застегнутая рубашка и слабые места для некоторой защиты от низкоуровневых лабораторных опасностей. Базовая униформа исследовательского подразделения Nanotrasen Corporation."

/obj/item/clothing/under/nanotrasen/science/robotics
	name = "роботизированный комбинезон"
	desc = "Дешевый черный комбинезон с синими вспышками рук. Расходная броня против масла и искр, выданная в массовом порядке техникам робототехники Nanotrasen."

/obj/item/clothing/under/nanotrasen/science/director
	name = "слабые места директора по науке"
	desc = "Хорошо сделанная черная рубашка с синими брюками, практически умоляющая быть в паре с галстуком какого-то описания. Логотипы Nanotrasen аккуратно сшиты в воротник и манжеты."

/obj/item/clothing/under/nanotrasen/medical
	name = "медицинская слабость"
	desc = "Чистая белая рубашка с синими полосами на руках, идентифицирующая владельца как обученный медицинский персонал DeForest. Слабый запах антисептика не смоет."

/obj/item/clothing/under/nanotrasen/medical/paramedic
	name = "парамедик в форме"
	desc = "Жесткие синтетические брюки и белая однородная рубашка, предназначенная для обработки всевозможных царапин и брызг при исполнении служебных обязанностей. Тег идентифицирует это как собственность медицинской компании DeForest."

/obj/item/clothing/under/nanotrasen/medical/director
	name = "слабые места медицинского директора"
	desc = "Опрятная синяя рубашка с белыми повязками на руках и удобными черными брюками. Логотипы Nanotrasen тонко вшиваются в воротник и манжеты вместе с небольшой эмблемой DeForest Medical. пахнет сожженным кофе и антисептиком."

/obj/item/clothing/under/nanotrasen/janitor
	name = "комбинезон для содержания под стражей"
	desc = "Серый комбинезон с фиолетовыми рукавами и слабыми пятнами на локтях и коленях. Он выглядит жестким и дешевым, но удивительно удобным."

/obj/item/clothing/under/nanotrasen/affairs
	name = "аккуратно мягкие слаксы"
	desc = "Безупречно плиссированные брюки и льняная рубашка с логотипом Nanotrasen неоднократно вшивались в манжеты и воротник. Это источает ауру тихой власти."

/obj/item/clothing/under/nanotrasen/security
	name = "отсутствие безопасности"
	desc = "Звёздно-серая униформа с красными вспышками рук, такого типа, который можно увидеть во всех основных мирах. Логотип Vigilitas Interstellar гордо украшен на лицевой стороне."

/obj/item/clothing/under/nanotrasen/security/director
	name = "слабые места директора по безопасности"
	desc = "Надежная багровая униформа, сильно выжженная, с логотипом Vigilitas, аккуратно сшитым на любом конце воротника. последняя линия обороны управленческого штаба Вигилитаса."

/obj/item/clothing/under/nanotrasen/captain
	name = "голубые капитанские брюки"
	desc = "Качественная униформа в Nanotrasen Blue с золотой отделкой. Золотые значки логотипа Nanotrasen украшают воротник и манжеты. Тонкие ткани и комфортная посадка отличают это от более утилитарной формы, которую носят сотрудники более низкого уровня."

/obj/item/clothing/under/nanotrasen/captain/skirt
	name = "голубая капитанская юбка"
	desc = "Качественная униформа в Nanotrasen Blue с золотой отделкой. Золотые значки логотипа Nanotrasen украшают воротник и манжеты. Тонкие ткани и комфортная посадка отличают это от более утилитарной формы, которую носят сотрудники более низкого уровня."

