	name = "\improper FEA Атмосферная плита"
	desc = "Эта мемориальная доска посвящена падению подразделения Atmos FEA. Для всех обугленных, головокружительных и хрупких мужчин, которые умерли в его руках."

/obj/structure/plaque/static_plaque/thunderdome
	name = "Thunderdome Plaque"
	desc = "Эта мемориальная доска посвящена тем, кто пал в славной битве. За всех обугленных, головокружительных и избитых мужчин, погибших в его руках."

/obj/structure/plaque/static_plaque/golden
	name = "премия «Самые сильные мужчины» за прочность"
	desc = "Быть сильным — это не действие или образ жизни, а психическое состояние. Только те, у кого сила воли достаточно сильна, чтобы действовать во время кризиса, спасая друга от врага, действительно надежны. Оставайтесь верными моим друзьям."

/obj/structure/sign/plaques/kiddie
	name = "\improper AI developers plaque"
	desc = "Рядом с чрезвычайно длинным списком имен и названий должностей есть рисунок маленького ребенка. Ребенок кажется инвалидом. под изображением кто-то поцарапал слово «пакеты»."

/obj/structure/sign/plaques/kiddie/badger
	name = "\improper мемориальная доска"
	desc = "Надпись, посвященная павшим, да упокоятся они с миром, вечно спящие среди звезд. Кто-то нарисовал картину плачущего барсука внизу."

/obj/structure/sign/plaques/kiddie/library
	name = "\improper знак библиотечных правил"
	desc = "Длинный список правил, которым нужно следовать в библиотеке, превознося достоинства тишины во все времена и угрожая тем, кто осмелится съесть горячую пищу внутри."

/obj/structure/sign/plaques/kiddie/perfect_man
	name = "Знак «Идеальный человек»"
	desc = "Руководство по выставке, объясняющее, как последние разработки в области имплантации и технологий клонирования щита разума корпорации Макоссо-Варра привели к развитию и эффективному бессмертию «идеального человека», верного сотрудника Макоссо-Варры."

/obj/structure/sign/plaques/kiddie/perfect_drone
	name = "Знак «Идеальный дрон»"
	desc = "Руководство по диспенсеру снарядов дронов, подробно описывающее конструктивное и разрушительное применение современных ремонтных дронов, а также разработку неподкупных киборгов-слуг завтрашнего дня, доступных сегодня."

