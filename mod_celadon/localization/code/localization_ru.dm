/obj/structure/elite_tumor
	name = "пульсирующая опухоль"
	desc = "Странная, пульсирующая опухоль, торчащая из земли. Вы чувствуете себя вынужденным протянуть руку и прикоснуться к ней."

/obj/item/tumor_shard
	name = "осколок опухоли"
	desc = "Странный, острый, хрустальный осколок от странной опухоли на Лаваленде. Уничтожение трупа лавалендской элиты этим оживит их, предполагая, что их душа еще задерживается. Возрожденные лавалендские элиты имеют только половину своего максимального здоровья, но полностью лояльны к своему возрожденцу."

/* C:\Shiptest\code\modules\mob\living\simple_animal\hostile\mining_mobs\elites\goliath_broodmother.dm */

/mob/living/simple_animal/hostile/asteroid/elite/broodmother
	name = "родная мать голиафа"
	desc = "Голиафы являются последовательными гермафродитами и редко вступают в яйцевидную или «женскую» фазу. Как ясно показывает этот образец, голиафы в этой фазе становятся значительно крупнее и агрессивнее. Эти «кровавые» еще более опасны, чем обычная разновидность, и их лучше избегать полностью."

/mob/living/simple_animal/hostile/asteroid/elite/broodmother_child
	name = "малыш голиаф"
	desc = "Голиафы являются ововивипарами; Во время вынашивания яиц они инкубируют яйца внутри матери. Новоиспеченные Голиафы, подобные этому, преждевременны и могут защитить себя и свою мать с момента вылупления."

/mob/living/simple_animal/hostile/asteroid/elite/broodmother_child/rockplanet
	name = "детский грубоид"
	desc = "Новорожденный грубоид. Хотя их шкура менее долговечна, чем у зрелого грубоида, они одинаково способны защищаться."

