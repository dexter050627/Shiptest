/obj/item/reagent_containers/food/drinks/bottle/goldschlager
	name = "Золотой стандарт студенческого союза"
	desc = "Крайне высокопрочные шнапсы с корицей, обычно встречающиеся в памятных бутылках в Студенческо-союзной ассоциации натуралистических наук. почти непитые и с безвкусным количеством золотых хлопьев, плавающих внутри."

/obj/item/reagent_containers/food/drinks/bottle/cognac
	name = "Коньяк Geheimnis"
	desc = "В то время как происхождение названия «коньяк» теряется со временем, этот тип коньяка зарезервирован как высококлассный напиток с определенными методами пивоварения."

/obj/item/reagent_containers/food/drinks/bottle/wine
	name = "Вальштетте Совиньон"
	desc = "Бутылка вина, сваренная из винограда, специально выращенного в Neue Waldstätte. Вы видели их в бутылках, продаваемых специально для туристов."

/obj/item/reagent_containers/food/drinks/bottle/absinthe
	name = "Северный зеленый абсент"
	desc = "Сильный абсент, сваренный в Федерации пан-Гезенан, с их собственными пересадками червячного дерева, подаренными им во время первого контакта с человечеством. Если легенда (и ярлык) что-то значат, то первая попытка заваривания этого вызвала падение хвоста бедного сарати."

/obj/item/reagent_containers/food/drinks/bottle/absinthe/premium
	name = "Золотой абсент Chacheyi"
	desc = "Более высокий абсент, распространяемый в основном из The Shoal. На этикетке изображен фолкгеро Чачеи вместе со своими компаньонами."

/obj/item/reagent_containers/food/drinks/bottle/lizardwine
	name = "бутылка Blueflame Pyrecask"
	desc = "Алкогольный напиток, происходящий из изолированных виноградников на Зогиле, поддерживаемый религиозными сектами Синего пламени. Сейчас такие популярные и качественные имитационные бутылки можно найти повсюду. проверьте этикетку на место происхождения."

/obj/item/reagent_containers/food/drinks/bottle/hcider
	name = "Гамбургский сидр"
	desc = "Один из главных экспортеров Нойе Гамбург — твердый, пряный сидр. Наслаждались всем в кантонах и за их пределами."

/obj/item/reagent_containers/food/drinks/bottle/amaretto
	name = "Лу'Ни'Ксер Нан Амаретто"
	desc = "популярный Рахнид берется за рецепт Амаретто, который упал до безвестности после того, как был полуоткрыт солярианскими историками. представлено полуреконструированное изображение предполагаемой истории происхождения, с художником Лу’Ни’Ксер’Наном и ее музой, трактирщиком."

/obj/item/reagent_containers/food/drinks/bottle/grappa
	name = "Нойе Майнила Граппамиэль"
	desc = "Бутылка Grappa, приготовленная на основе меда. Обычно рассматривается как напиток для переработки винограда после его использования в виноделии и обычно рассматривается как зимний напиток."

/obj/item/reagent_containers/food/drinks/bottle/sake
	name = "Сакамаи Саке"
	desc = "Алкогольный напиток, полученный из риса, вновь обнаруженный солярианскими историками и восстановленный по мере их способности воспроизводить его."

/obj/item/reagent_containers/food/drinks/bottle/sake/foxgirl
	name = "Флаффи Тейл Саке"
	desc = "Алкогольный напиток, полученный из риса, вновь обнаруженный солярианскими историками и восстановленный по мере их способности воспроизводить его. Талисман этой конкретной марки - человек с смутно собачьими ушами и хвостом."

/obj/item/reagent_containers/food/drinks/bottle/sake/wolfgirl
	name = "Домой пиво Инубашири"
	desc = "Алкогольный напиток, полученный из риса, вновь обнаруженный солярианскими историками и восстановленный по мере их способности воспроизводить его. Талисман этого бренда — человек с девятью хвостами лисицы, что является впечатляющим количеством геномдинга."

/obj/item/reagent_containers/food/drinks/bottle/fernet
	name = "Фернет Бронка"
	desc = "Горький и ароматный напиток, обычно используемый в межсолнечных кантонах из-за ослабленных алкогольных тарифов, технически классифицируемых как лекарственный напиток. Обычно смешивается с безалкогольными напитками на основе колы."

/obj/item/reagent_containers/food/drinks/bottle/triplesec
	name = "Тройной ликер Teeka-Gih"
	desc = "Бутылка тройной сек, родом из Безутов."

/obj/item/reagent_containers/food/drinks/bottle/milk
	name = "бутылка коровьего молока"
	desc = "Бутилированное молоко коровы, домашней коровы солярианского происхождения."

/obj/item/reagent_containers/food/drinks/bottle/orangejuice
	name = "апельсиновый сок"
	desc = "Сладкий и терпкий апельсиновый сок. Обычно его находят укрепленным, чтобы сделать его более питательным. полный витамин С!"

/obj/item/reagent_containers/food/drinks/bottle/lemonjuice
	name = "лимонный сок"
	desc = "Лимонад для всех!"

/obj/item/reagent_containers/food/drinks/bottle/cream
	name = "молочный крем"
	desc = "Крем из молока. Он толще молока, что, надеюсь, предотвращает любые перемешивания."

/obj/item/reagent_containers/food/drinks/bottle/tomatojuice
	name = "томатный сок"
	desc = "Сок из помидоров и соли. Вы часто найдете некоторых техников, замачивающихся в этом, если они работали с плазмой."

/obj/item/reagent_containers/food/drinks/bottle/limejuice
	name = "сок лайма"
	desc = "Сок лайма. Возможно, вы захотите смешать что-то с этим, вместо того, чтобы пить его прямо."

/obj/item/reagent_containers/food/drinks/bottle/pineapplejuice
	name = "ананасовый сок"
	desc = "Тарт, сладкий сок из тропического ананаса."

/obj/item/reagent_containers/food/drinks/bottle/menthol
	name = "ментол"
	desc = "Вкус естественно мятный, и придает очень мягкое ощущение онемения."

/obj/item/reagent_containers/food/drinks/bottle/grenadine
	name = "Трехзвездочная Гренадина"
	desc = "Обычно встречается бутылка гренадина или сладкий фруктовый сироп. Он может даже содержать настоящую вишню, а также черную смородину для цвета."

/obj/item/reagent_containers/food/drinks/bottle/applejack
	name = "Mars Lightning Applejack"
	desc = "Сильный бренди, происходящий из яблок, считался старшим братом твердого сидра. Mars Lightning часто сотрудничает с антигравитационными гоночными компаниями, что приводит к тому, что его часто подают прямо или для импровизированных миксов."

/obj/item/reagent_containers/food/drinks/bottle/champagne
	name = "Шампанское Треу"
	desc = "прекрасно получено из целых кантонов, посвященных верному воспроизведению виноградников до Ночи огня. Обычно наслаждались праздниками и наступлением новых лет."

/obj/item/reagent_containers/food/drinks/bottle/blazaam
	name = "Гиперпространственный хайбол"
	desc = "печально дорогой, печально известный содержит голубые пятна для хвастовства правами и печально известный удален с большинства полок из-за несчастных случаев, связанных с несчастными случаями телепортации при приеме внутрь."

/obj/item/reagent_containers/food/drinks/bottle/trappist
	name = "Румен Траппер"
	desc = "Традиционно (и в значительной степени контролируется на подлинность) пиво варили на Illestren. пиво Трэппера должно быть сварено Охотниками Сен-Румена или Тенями, сделано, чтобы соответствовать потребностям их сообщества в первую очередь, и никогда не должно быть сделано для прибыли."

/obj/item/reagent_containers/food/drinks/bottle/hooch
	name = "бутылочка"
	desc = "Бутылка домашнего пива, низкокачественный алкоголь. Бумажная обертка покрыта маленькими подписями и сообщениями — сколько рук прошло эту бутылку до того, как вы пришли?"

/obj/item/reagent_containers/food/drinks/bottle/chemshine
	name = "кувшин химшины"
	desc = "Высокопрочный крепкий ликер, скорее всего, сделанный в уединении бутлегера. Дистиллированный из ракетного топлива в перепрофилированных радиаторах охлаждающей жидкости, это, вероятно, не лучшая идея, чтобы пить это; особенно не умереть с ним в вашей системе."

/obj/item/reagent_containers/food/drinks/bottle/cacao
	name = "Чистое наслаждение какао Шарая"
	desc = "похоже на рекламный продукт для видеоигры Teceti. Вы уверены, что это синтетический материал."

/obj/item/reagent_containers/food/drinks/bottle/menthe
	name = "Оригинальное название: Mora's Pure Mint Delight"
	desc = "похоже на рекламный продукт для видеоигры Teceti. Вы уверены, что это синтетический материал."

/obj/item/reagent_containers/food/drinks/bottle/dotusira
	name = "Дотусира Ракире"
	desc = "Бутылка ликера Dotusira, украшенная крошечными фруктами и ягодами. Небольшая этикетка на бутылке объявляет его продуктом Южного комбината Течети."

/obj/item/reagent_containers/food/drinks/bottle/faraseta
	name = "Фарасета Лирили!"
	desc = "Высокая, стройная бутылка сидра Фарасеты. Декоративное пламя запускает основание бутылки. Небольшой лейбл объявляет его продуктом Северной Коалиции Течети."

/obj/item/reagent_containers/food/drinks/bottle/sosomira
	name = "Икики Сососи-Мира"
	desc = "Бутылка Сососи-Мира, сделанная пивоварней Икики. Особенно маленький Vox рисуется, чтобы убедиться, что вы знаете, что в бутылке нет никаких Miras (потенциально потому, что они съели его)."

/obj/item/reagent_containers/food/drinks/bottle/sososeta
	name = "Мескили Клир Сососи-Сета"
	desc = "Бутылка Sososi-Seta, полученная из ответственно выращенных растений сосоли, ягод дотов и достаточно времени, чтобы соляриане считали ее винтажной."

/obj/item/reagent_containers/food/drinks/molotov
	name = "коктейль молотова"
	desc = "Бросающее оружие, используемое для зажигания вещей, обычно заполненное ускорителем. Отчаянные ополченцы и революционеры настоятельно рекомендуют. Свет и бросок."

/obj/item/reagent_containers/food/drinks/bottle/pruno
	name = "микширование пруно"
	desc = "Мусорный мешок, наполненный фруктами, сахаром, дрожжами и водой, сливается в острую суспензию, которая ферментируется в закрытом пространстве, традиционно туалете."

/obj/item/reagent_containers/food/drinks/colocup/lean
	name = "худой"
	desc = "Несмотря на то, что это сочетание кодеинового сиропа от кашля и безалкогольного напитка, популярного в Интернете, вы не уверены, что кто-либо когда-либо пробовал его. первый раз за всё?"

/obj/item/reagent_containers/food/drinks/bottle/sarsaparilla
	name = "песчаный взрыв Сарсапарилья"
	desc = "Бренд корневого пива, который был произведен и очень популярен на внешней границе. В то время как компания, производящая его, была разрушена в ICW, его популярность приводит к тому, что ящики, заполненные Сарсапариллой, остаются позади."

/obj/item/sandstar
	name = "Звезда SandBlast Sarsaparilla"
	desc = "Легенда гласит, что что-то удивительное происходит, когда вы собираете достаточно этих вещей."

/obj/item/storage/bottles
	name = "ящик для бутылок"
	desc = "Небольшой ящик для хранения бутылок"

/obj/item/storage/bottles/sandblast
	name = "ящик для бутылок сарсапарилла"
	desc = "Вмещает шесть бутылок лучшей сарсапариллы по эту сторону границы."

/obj/item/storage/bottles/chemshine
	name = "ящик для бутылок с хемшином"
	desc = "Вмещает четыре бутылки самого крепкого крючка по эту сторону Границы."

/* C:\Shiptest\code\modules\food_and_drinks\drinks\drinks\breakawayflask.dm */

/obj/item/reagent_containers/food/drinks/breakawayflask
	name = "отколовшаяся колба"
	desc = "Специальная колба, предназначенная для стабилизации Illestren Bacterium и разрушения при контакте."

/obj/item/reagent_containers/food/drinks/breakawayflask/vintage
	name = "Винтажный Saint-Roumain Trickwine"
	desc = "Одна из первых бутылок, изготовленных"

/obj/item/reagent_containers/food/drinks/breakawayflask/vintage/ashwine
	name = "Винтажное вино Ash"
	desc = "Вино из пепла первоначально было создано с использованием трав, произрастающих в Illestren, в качестве средства для отдыха после долгой охоты. У ополчения Сен-Румена нет запрета на небольшое веселье."

/obj/item/reagent_containers/food/drinks/breakawayflask/vintage/icewine
	name = "Винтажное вино из льда"
	desc = "Wine Of Ice, вдохновленный холодными склонами «Godforsaken Precipice», которые сформировали репутацию группы как доблестных выживших, был разработан, чтобы успокоить перегретых Охотников и заморозить их врагов в их следах."

/obj/item/reagent_containers/food/drinks/breakawayflask/vintage/shockwine
	name = "Благословение винтажных молний"
	desc = "Благословение Lightnings, призванное оживить потребителей и вывести из строя цели, черпало вдохновение из инцидента в начале истории ополчения Сен-Румена, когда молодая Тень остановила бушующего зверя, погрузив электрический кабель, который был вытеснен в бою на свою сторону."

/obj/item/reagent_containers/food/drinks/breakawayflask/vintage/hearthwine
	name = "Винтажный Hearthflame"
	desc = "Hearthflame является одним из самых важных тоников, разработанных SRM - как для его мощных способностей в стойких ранах или воспламенении врагов, так и для его близости к божественному огню, связанному с Охотником Ашеном."

/obj/item/reagent_containers/food/drinks/breakawayflask/vintage/forcewine
	name = "Винтажный Saint-Roumain Forcewine"
	desc = "Forcewine изначально создавался как средство для создания временных укрытий во время длительных слежения за экспедициями. В то время как структуры оказались не такими универсальными по форме, как надеялись пивовары, их полезность в создании баррикад или покорении врагов все еще была высоко оценена."

/obj/item/reagent_containers/food/drinks/breakawayflask/vintage/prismwine
	name = "Винтажный Сен-Румен присмвин"
	desc = "Prismwine является одним из последних дополнений к резерву триквинов ополчения Сен-Румена. Он был создан специально для борьбы с врагами, которые использовали более совершенные энергетические атаки, такие как крионические лучи наблюдателей или лазерные пушки межзвездных пиратов."

/* C:\Shiptest\code\modules\food_and_drinks\drinks\drinks\drinkingglass.dm */

/obj/item/reagent_containers/food/drinks/drinkingglass
	name = "пить стакан"
	desc = "Стандартный стакан для питья."

/obj/item/reagent_containers/food/drinks/drinkingglass/shotglass
	name = "выстрелить в стекло"
	desc = "простреленное стекло — универсальный символ плохих решений."

/obj/item/reagent_containers/food/drinks/drinkingglass/shotglass/commemorative
	name = "памятный выстрел из стекла"
	desc = "простреленное стекло — универсальный символ плохих решений. На дне выгравировано грибное облако, а вокруг края написаны слова «ААА-200»."

