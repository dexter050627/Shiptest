/obj/structure/sign/poster/pol/pol_5
	name = "помогите!"
	desc = "На этом плакате изображен мужчина, помогающий другому человеку встать."

/obj/structure/sign/poster/pol/pol_6
	name = "Иди!"
	desc = "На этом плакате изображен человек, идущий, предположительно, чтобы побудить вас не бегать по залам."

