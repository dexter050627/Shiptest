/obj/item/clothing/suit/warra/vest/blue
	name = "голубой жилет опасности"
	desc = "Тонкий жилет с отражающими полосами, надеваемый для обеспечения видимости в опасных условиях. Сам жилет представляет собой наступательно яркий оттенок синего Макоссо-Варры. производитель: Makosso-Warra Corporation"

/obj/item/clothing/suit/toggle/warra
	name = "офицерское пальто"
	desc = "Умная синяя униформа с красными шелковыми акцентами и большая пряжка с выгравированным логотипом Макоссо-Варра. Стандартная одежда для командиров на борту кораблей корпорации «Макоссо-Варра»."

/obj/item/clothing/suit/toggle/labcoat/warra
	name = "корпоративный плащ"
	desc = "Стандартизированный белый плащ, используемый медицинскими и исследовательскими подразделениями корпорации Макоссо-Варра. Упрощенный логотип Макоссо-Варра сшита на передней части."

/obj/item/clothing/suit/toggle/labcoat/warra/blue
	name = "лабкоат медицинского директора"
	desc = "Хорошо сделанный, установленный плащ, изготовленный из высококачественных материалов и спортивных синих отметин вокруг рук и подола. Логотип Макоссо-Варра аккуратно вышит на лицевой стороне. Стильный, практичный и исключительно профессиональный."

/obj/item/clothing/suit/toggle/labcoat/warra/black
	name = "лабкоат директора по науке"
	desc = "перепроектированный и довольно пугающий черный халат с очень высоким воротником, столь же непроницаемый для лабораторных опасностей, как и без костюма для всего тела. Логотип корпорации Макоссо-Варра гордо украшен на груди."

/obj/item/clothing/suit/toggle/labcoat/warra/paramedic
	name = "яркая голубая куртка фельдшера"
	desc = "Толстая защитная синяя куртка с отражающими полосами видимости и логотипом Макоссо-Варры, вшитым в грудь. Безопасен от всех видов царапин и брызг."

/obj/item/clothing/suit/toggle/chorejacket/warra
	name = "поставка куртки"
	desc = "Свободная облегающая куртка, предназначенная для работников N+S Logistics, с глубокими карманами и большими кнопками, обеспечивающими легкий доступ в условиях работы."

/obj/item/clothing/under/warra/supply/qm
	name = "директор по снабжению"
	desc = "Хрустящие брюки и коричневая рубашка, которыми может гордиться любой директор по снабжению. Эмблема N+S Logistics с розовым компасом выгравирована на каждой кнопке."

/obj/item/clothing/suit/armor/warra
	name = "бронежилет"
	desc = "прочный жилет, предназначенный для защиты сотрудников Vigilitas Interstellar от различных основных угроз. Спортивная красная полоса спереди."

/obj/item/clothing/suit/armor/warra/sec_director
	name = "пальто директора службы безопасности"
	desc = "Специальное черное пальто, изготовленное из передовых баллистических тканей и композитов. Логотип Vigilitas «VI» выбит на каждой кнопке. Устрашающе и глубоко стильно."

/obj/item/clothing/suit/armor/warra/captain
	name = "капитанская куртка"
	desc = "прочная куртка в Макоссо-Варра Блю, подчеркнутая золотой нитью и облицованная слоем баллистической ткани. Его большая блестящая пряжка на поясе украшена фирменным логотипом Makosso-Warra."

/obj/item/clothing/suit/armor/warra/captain/parade
	name = "показная капитанская куртка"
	desc = "прекрасная синяя куртка с изысканным декором, подходящая для особых формальных ситуаций, или для командира, который хочет выставить напоказ свой статус даже больше, чем обычно. Богато украшен золотой нитью и вышитыми логотипами Макоссо-Варра."

/obj/item/clothing/head/warra
	name = "голубой плоский"
	desc = "простая синяя плоская кепка с логотипом Макоссо-Варра на боку. Не стандартная униформа, но изредка носимая офисными работниками Макоссо-Варры."

/obj/item/clothing/head/warra/beret
	name = "голубой берет"
	desc = "Хорошо сделанный берет в Makosso-Warra Blue с корпоративным логотипом на боку, часто видимым, возглавляющим руководителей корпорации Makosso-Warra."

/obj/item/clothing/head/warra/beret/security
	name = "красный берет"
	desc = "Вишнево-красный берет, выданный офицерам безопасности Вигилиты для официальных случаев. Логотип Vigilitas Interstellar «VI» сшит в бок."

/obj/item/clothing/head/warra/beret/security/command
	name = "красивый черный берет"
	desc = "Глубокий черный берет с значком Vigilitas Interstellar 'VI' на фронте. Неопровержимая отличительная черта управленческого персонала Vigilitas."

/obj/item/clothing/head/warra/surgical
	name = "белая хирургическая крышка"
	desc = "Белая хирургическая шапка с синей полосой Макоссо-Варра посередине."

/obj/item/clothing/head/warra/surgical/blue
	name = "голубая хирургическая крышка"
	desc = "Макоссо-Варра Синий хирургический колпачок с белой полосой посередине, выданный медицинским директорам Макоссо-Варры в качестве последней линии узнаваемости, если их униформа, пальто и невозмутимый характер когда-либо потерпят неудачу."

/obj/item/clothing/head/warra/cap/security
	name = "красный софткок"
	desc = "Вишнево-красная шапка с белым логотипом «VI», вышитым на лицевой стороне. Выдается охранникам Вигилиты как повседневная одежда и рабочая одежда с низким уровнем угрозы. Удивительно прочный и очень популярный среди нынешних и отставных сотрудников."

/obj/item/clothing/head/helmet/m10/warra
	name = "\improper Vigilitas Helmet"
	desc = "Классический защитный шлем, используемый Vigilitas, с использованием шлема M-10 с их цветовой гаммой!"

/obj/item/clothing/head/helmet/bulletproof/x11/warra
	name = "\improper Bulletproof Vigilitas Helmet"
	desc = "Массивный пуленепробиваемый шлем в модели X-11, используемый Vigilitas и MW для предотвращения потерь!"

/obj/item/clothing/head/helmet/riot/warra
	name = "\improper Vigilitas Riot Helmet"
	desc = "Стойкий шлем для охраны в Вигилитасе, часто используемый для подавления бунтовщиков на корпоративных площадках."

/obj/item/clothing/head/warra/cap/supply
	name = "коричневый softcap"
	desc = "Коричневая кепка с логотипом N+S Logistics на лицевой стороне. Выдается практически каждому сотруднику N+S, хотя его износ является необязательным."

/obj/item/clothing/head/warra/cap/janitor
	name = "фиолетовый софткап"
	desc = "Богатая фиолетовая мягкая кепка с логотипом Makosso-Warra на передней панели. по какой-то причине этот своеобразный оттенок фиолетового используется только персоналом службы опеки вместо синего цвета Макоссо-Варра, используемого любой другой дивизией. Он уже слегка запятнан."

/obj/item/clothing/head/warra/cap/medical
	name = "синий медицинский softcap"
	desc = "Мягкая кепка в синем Макоссо-Варра, с большим белым крестом на передней части, обозначающим владельца как обученного медицинского работника. Ношение этого без медицинской подготовки является нарушением руководящих принципов сотрудников корпорации Макоссо-Варра."

/obj/item/clothing/head/warra/officer
	name = "офицерская шляпа"
	desc = "Синая пиковая шляпа с красным шелковым украшением и вышитым логотипом Макоссо-Варры, которую носило исключительно руководство."

/obj/item/clothing/head/warra/officer/fedora
	name = "офицерская федора"
	desc = "Федора в бурном оттенке синего Макоссо-Варра с красной шелковой полосой."

/obj/item/clothing/head/warra/captain
	name = "широкая шляпа капитана"
	desc = "Любопытная закругленная шляпа, украшенная золотой нитью и значком логотипа Макоссо-Варра. Особенно капитанам корпорации Макоссо-Варра, хотя никто не уверен, откуда взялся этот отличительный дизайн."

/obj/item/clothing/head/warra/captain/peaked
	name = "капитанская кепка"
	desc = "Украшенная синяя пиковая кепка, изобилующая лаврами и золотой нитью, с большим значком на передней панели, отображающим логотип корпорации Макоссо-Варра. Эта шляпа практически сочит авторитет."

/obj/item/clothing/head/hardhat/warra/blue
	name = "синяя сверхмощная шляпа"
	desc = "Жесткий пластиковый шлем с подвеской, предназначенный для защиты от тупых ударов. Этот ярко окрашен в Makosso-Warra Blue с логотипом компании на лицевой стороне."

/obj/item/clothing/head/hardhat/warra/white
	name = "белая тяжёлая шляпа"
	desc = "Чрезвычайно жесткий пластиковый шлем с подвеской, предназначенный для защиты от тупых ударов. Этот цвет ярко-белый, типичный для управленческого персонала, и имеет логотип Макоссо-Варра на фронте."

/obj/item/clothing/neck/cloak/warra
	name = "командующий sash"
	desc = "Красный шелковый ломтик, который хорошо сочетался бы с формальной униформой. Небольшой тег внутри декларирует это свойство корпорации Макоссо-Варра"

/obj/item/clothing/mask/gas/vigilitas
	name = "противогаз Vigilitas"
	desc = "Защитный противогаз, предназначенный для первого реагирования, специальных операций и борьбы с терроризмом офицерами «Вигилитас Интерстеллар». Он имеет широкий устойчивый к царапинам козырь, порты для подключения подачи кислорода и безопасные, удобные ремни."

/* C:\Shiptest\code\modules\clothing\glasses\engine_goggles.dm */

/obj/item/clothing/glasses/meson/engine
	name = "инженерные очки сканера"
	desc = "Очки, используемые инженерами. Режим Meson Scanner позволяет видеть основные структурные и ландшафтные макеты через стены, режим T-ray Scanner позволяет видеть объекты под полом, такие как кабели и трубы, а режим радиационного сканера позволяет видеть объекты, загрязненные радиацией."

/obj/item/clothing/glasses/meson/engine/shuttle
	name = "шаттл региональный сканер"
	desc = "Используется для наблюдения за границами районов шаттлов."

/obj/item/clothing/glasses/meson/prescription
	name = "оптический мезонный сканер"
	desc = "Используется инженерным и горнодобывающим персоналом для просмотра основных конструкций и рельефа местности через стены, независимо от условий освещения. Эта пара также исправляет близорукость."

/obj/item/clothing/glasses/meson/sunglasses
	name = "оптические сканеры мезона"
	desc = "Используется инженерным и горнодобывающим персоналом для просмотра основных конструкций и рельефа местности через стены, независимо от условий освещения. Эта пара встроена в пару солнцезащитных очков."

