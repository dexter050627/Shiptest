	desc = "Компактная ячейка оружия, используемая исключительно оружием Sharplite Plasma. Он содержит меньше заряда и предназначен для использования в энергетических пистолетах."

/* C:\Shiptest\mod_celadon\weapons\code\modules\projectiles\guns\energy\laser.dm */

/obj/item/gun/energy/laser/retro
	name = "Лазерный пистолет SL L-104"
	desc = "Устаревшая модель L-204, больше не используемая и не продаваемая Sharplite. Тем не менее, чистая популярность этой модели делает ее довольно распространенным явлением по сей день."

/obj/item/gun/energy/laser/captain
	name = "Лазерный пистолет SL X-00"
	desc = "Это SL X-00, антикварная лазерная пушка, которая не производилась десятилетиями и не могла быть воссоздана. Все мастерство имеет высочайшее качество. Он украшен ашдрейковой кожей и хромом. Оружие угрожает всплесками энергии. На предмете — изображение космического корабля. Корабль взрывается."

