/obj/structure/sign/poster/official/mini_energy_gun
	name = "Мини-энергетический пистолет"
	desc = "плакат, рекламирующий новый и технически впечатляющий SL X-26. «Власть в кармане!»"

/obj/structure/sign/poster/official/high_class_martini
	name = "Высококлассный Martini"
	desc = "Я сказал тебе встряхнуть его, не мешая."

/obj/structure/sign/poster/official/the_owl
	name = "Сова"
	desc = "Сова сделает все возможное, чтобы защитить колонии. Ты не против?"

/obj/structure/sign/poster/official/no_erp
	name = "Нет ERP"
	desc = "Этот плакат напоминает зрителям немедленно прекратить то, что они делают прямо сейчас. Да, ты. Ты знаешь, что делаешь."

/obj/structure/sign/poster/official/wtf_is_co2
	name = "Диоксид углерода"
	desc = "Этот информационный плакат учит зрителя, что такое углекислый газ."

/obj/structure/sign/poster/official/focus
	name = "Сосредоточься! Мотивационный плакат"
	desc = "Фокус! пусть ваша энергия будет определена"

/obj/structure/sign/poster/retro/warra_logo_70s
	name = "Древний логотип Макоссо-Варра"
	desc = "плакат, изображающий старый логотип Макоссо-Варры. Эта штука древняя."

/obj/structure/sign/poster/retro/warra_logo_80s
	name = "\improper логотип Makosso-Warra"
	desc = "плакат, изображающий логотип эпохи ICW Макоссо-Варры. У него хорошая эстетика."

/obj/structure/sign/poster/retro/smile
	name = "Улыбаться"
	desc = "переверни хмурый вверх дном! У него хорошая эстетика."

/obj/structure/sign/poster/retro/we_watch
	name = "Мы смотрим"
	desc = "Большой Брат всегда смотрит. Но вместо того, чтобы контролировать тебя, он пытается заставить тебя прекратить бездельничать. У него хорошая эстетика."

/obj/structure/sign/poster/retro/build
	name = "Строить"
	desc = "плакат, прославляющий инженерную команду. У него хорошая эстетика."

/obj/structure/sign/poster/retro/science
	name = "Наука"
	desc = "плакат, изображающий атом. У него хорошая эстетика."

/obj/structure/sign/poster/retro/pdaancient
	name = "PDA Ad"
	desc = "плакат, рекламирующий оригинальный Thinkitronic PDA после того, как компания была приобретена Макоссо-Варрой. Эта штука поставляется с серьезными проблемами, такими как «бомбардировка» сообщений PDA и ошибки памяти. Несмотря на это, он с любовью запоминается. Эта штука древняя."

/obj/structure/sign/poster/retro/lasergun
	name = "Ретро лазерное оружие"
	desc = "плакат, рекламирующий ретро-лазерную пушку, когда она была новой и называлась L-104. Эта штука древняя."

/obj/structure/sign/poster/retro/lasergun_new
	name = "Старый лазерный пистолет"
	desc = "плакат, рекламирующий более старую версию L-704, модель L-204. У него хорошая эстетика."

/obj/structure/sign/poster/retro/radio
	name = "Радио"
	desc = "плакат, рекламирующий один из самых ранних продуктов Макоссо-Варры, радио. Одним из его главных пунктов продажи была интегрированная ОС и двухсторонний автоматический перевод для Solarian Common и Gezenan, что сделало его хитом. Эта штука древняя."

/obj/structure/sign/poster/official/moth
	name = "Безопасная моль - отравление"
	desc = "Этот информационный плакат использует «Безопасный моль», чтобы сказать зрителю не отравлять важные товары и опасаться подозрительных продуктов. Он подписан \"AspEv\"."

/obj/structure/sign/poster/official/moth/boh
	name = "Мотылек безопасности - BoH"
	desc = "Этот информационный плакат использует Safety Moth (TM) для информирования зрителя об опасностях Bags of Holding. Он подписан \"AspEv\"."

/obj/structure/sign/poster/official/moth/hardhats
	name = "Мотылек безопасности - Hardhats"
	desc = "Этот информационный плакат использует Safety Moth (TM), чтобы сказать зрителю носить хардхаты в осторожных областях. Это как лампа для твоей головы! Он подписан \"AspEv\"."

/obj/structure/sign/poster/official/moth/smokey
	name = "Безопасная моль - Смоки?"
	desc = "Этот информационный плакат использует Мотылек безопасности (TM) для содействия безопасному обращению с плазмой или продвижения экипажа для борьбы с плазменными огнями. Мы не можем сказать. Он подписан \"AspEv\"."

/obj/structure/sign/poster/official/moth/piping
	name = "Мотылек безопасности - Piping"
	desc = "Этот информационный плакат использует Safety Moth (TM), чтобы сообщить атмосферным техникам правильные типы трубопроводов, которые будут использоваться. правильное размещение трубы предотвращает плохую преформу! Он подписан \"AspEv\"."

/obj/structure/sign/poster/official/moth/supermatter
	name = "Безопасная моль - суперматерия"
	desc = "Этот информационный плакат использует Мотылек безопасности (TM) для продвижения надлежащего оборудования безопасности при работе вблизи Кристалла Суперматерии. Он подписан \"AspEv\"."

/obj/structure/sign/poster/official/moth/meth
	name = "Молоко безопасности - Метамфетамин"
	desc = "Этот информационный плакат использует Safety Moth (TM), чтобы сказать зрителю, чтобы получить одобрение CMO перед приготовлением метамфетамина. Тебе даже не стоит это делать. Он подписан \"AspEv\"."

/obj/structure/sign/poster/official/moth/epi
	name = "Безопасная моль - эпинефрин"
	desc = "Этот информационный плакат использует Мотылек безопасности (TM), чтобы информировать зрителя, чтобы помочь раненым / погибшим членам экипажа с их инжекторами эпинефрина. Он подписан \"AspEv\"."

/obj/structure/sign/poster/official/moth/delam
	name = "Безопасная моль - Меры предосторожности"
	desc = "Этот информационный плакат использует Safety Moth (TM), чтобы сказать зрителю спрятаться в шкафчиках, когда Кристалл Суперматерии расслоился. Бегство может быть лучшей стратегией. Он подписан \"AspEv\"."

/obj/structure/sign/poster/contraband/syndiemoth
	name = "Синди Мот - Ядерная операция"
	desc = "плакат, созданный синдикатом, который использует Syndie Moth (TM?), чтобы сказать зрителю, чтобы диск ядерной аутентификации не был защищен. Он подписан \"AspEv\"."

/obj/structure/sign/poster/contraband/mothpill
	name = "Таблетки безопасности - Метамфетамин"
	desc = "плакат, который использует таблетки безопасности (TM?) для продвижения менее легальных химических веществ. Это одна из причин, по которой Макоссо-Варра прекратила аутсорсинг своих плакатов. Частично подписано \"AspEv\"."

/obj/structure/sign/poster/solgov/solgov_logo
	name = "СолГов"
	desc = "печать самой серенной солнечной и межсолнечной конфедерации, более известной как Солгов. «Государство есть саженец: воды перемен могут утопить его, и лучи страха могут иссохнуть его, но благоустроенный он однажды принесет плоды»"

/obj/structure/sign/poster/solgov/terra
	name = "Терра"
	desc = "Терра, или Земля, как ее называют жители, третья планета в Солнечной системе. Дом для единственной жизни, какой ее знали люди, до контакта с внешней вселенной. Этот плакат, в частности, пытается привлечь туристов на Терру, перечисляя такие достопримечательности, как Гранд Оррери и Нойе Вальдштатте."

/obj/structure/sign/poster/solgov/mars
	name = "Марс"
	desc = "Марс, четвертая планета Солнечной системы. Хотя данные свидетельствуют о том, что Венера и Марс, возможно, когда-то имели жизнь, Терра была единственной, кто сохранил ее. Этот плакат, в частности, пытается привлечь туристов на Марс, перечисляя такие достопримечательности, как горнолыжные курорты и экспонаты древних роботов."

/obj/structure/sign/poster/solgov/luna
	name = "Луна"
	desc = "Луна, единственная луна Терры. Культурно значимый для солярианцев исторически как символ времени, урожая и новых рубежей. Этот плакат, в частности, пытается привлечь туристов на Луну, перечисляя такие достопримечательности, как массивный космодром и белые флаги, разбросанные по поверхности."

/obj/structure/sign/poster/solgov/kepler
	name = "Кеплер 453b"
	desc = "Kepler 453b — единственная колонизированная планета в системе Kepler 453. Этот плакат, в частности, пытается привлечь туристов на планету, перечисляя такие достопримечательности, как соленая пустыня и двойные солнца. «Где у твоей тени всегда есть компания!»"

/obj/structure/sign/poster/solgov/skiing
	name = "Лыжная реклама"
	desc = "Реклама горнолыжного курорта с низкой гравитацией на Марсе. «Народные группы с солнцем!»"

/obj/structure/sign/poster/solgov/recyle
	name = "перерабатывать"
	desc = "популярный плакат, напоминающий читателю о необходимости утилизации, чтобы планета и корабли были чистыми!"

/obj/structure/sign/poster/solgov/terragov
	name = "ТерраГов"
	desc = "Герб ТерраГова и Терранское регентство, которое существует и по сей день."

/obj/structure/sign/poster/solgov/paperwork
	name = "Документы"
	desc = "плакат, напоминающий госслужащим, что их обязанность — вести подробные записи."

/obj/structure/sign/poster/solgov/sonnensoldner
	name = "Сонненсёлднеры"
	desc = "Символ многих солнечных компаний."

/obj/structure/sign/poster/solgov/nanomichi_ad
	name = "Наномичи Ад"
	desc = "плакат, рекламирующий ранний пост-NOF солярианский компьютер. Очень устаревшая, но реклама теперь довольно изящное украшение."

/obj/structure/sign/poster/clip/enlist
	name = "Записаться"
	desc = "Сделайте свою часть не только для CLIP, но и для Luna Town, Lanchester City, Serene, Star City, Ryunosuke, Lanshuka, Radinska, New Kalixcis и всех ваших семей! плюс, профинансируйте свое будущее; Это победа / победа, чтобы записаться в CMM"

/obj/structure/sign/poster/clip/bard
	name = "КЛИп-БАРД"
	desc = "плакат, сделанный солдатами для вербовки людей в CLIP-BARD, на котором изображен «Сержант Клюс», скашивающий волны и волны ксенофауны, и они взрываются в крови. Что-то подсказывает вам, что сервис гораздо менее интересен, чем этот."

/obj/structure/sign/poster/clip/gold
	name = "ЗОЛОТОЙ КЛИп"
	desc = "плакат с перечислением вакансий открывается в CLIP-GOLD и запрашивает заявки, перечисляя важные, но неинтересные льготы, такие как медицинское страхование и т. Д."

/obj/structure/sign/poster/clip/lunatown
	name = "Луна-Таун"
	desc = "Луна-таун, одна из многих лун газового гиганта Максина. Столица Конфедерации независимых планет. Этот плакат пытается поощрить туризм этим плакатом, перечисляя несколько туристических достопримечательностей, включая саму столицу и остатки Лихтенштейна UNSV, известного тем, что он привел CLIP с края в то, что он сегодня."

/obj/structure/sign/poster/clip/maxin
	name = "Максин"
	desc = "Максин, четвертая планета системы Канлер-332. Многие луны, включая Ланчестер-Сити, делают его популярной достопримечательностью для тех, кто направляется в Ланчестер-Сити."

/obj/structure/sign/poster/clip/lanchester
	name = "Ланчестер Сити"
	desc = "Ланчестер Сити, одна из многих лун газового гиганта Максина. Луна, известная своими многочисленными, массивными фабриками. Этот плакат пытается поощрить туризм этим плакатом, перечисляя несколько туристических достопримечательностей, таких как разбившиеся корабли пограничников и массовая индустрия развлечений."

/obj/structure/sign/poster/clip/serene
	name = "Серена"
	desc = "Серена, пятая планета системы Дружи. покрытая толстым листом снега, атмосфера была описана как «дышащая, если бы не было так чертовски холодно». Этот плакат пытается привлечь туризм этим плакатом, перечисляя несколько туристических достопримечательностей, таких как старые места войны пограничников и военные объекты Ксенофауны."

/obj/structure/sign/poster/clip/ryuunosuke
	name = "Рюуносукэ"
	desc = "Ryuunosuke, жемчужина системы Maebta и место силы для государства-члена CLIP Благородной Конфедерации Ryuunosuke. Он известен тем, что является одной из немногих пограничных планет, которые активно терраформировались во время заселения, и перечисляет несколько туристических достопримечательностей, включая приморские дворянские поместья, живописные пляжи и места битвы против солнечных компаний."

/obj/structure/sign/poster/clip/clover
	name = "Кловер"
	desc = "Вечно счастливая колония Кловер, когда-то одна из многих корпоративных колоний Макоссо-Варры, теперь превратилась в трудолюбивое и богатое государство-член CLIP. Своеобразная корпоратократия, которая ценит своих сотрудников; это холодная, влажная планета, в которой находится штаб-квартира Clover Corporation, которая производит много потребительских товаров Лиги. плакат предлагает такие достопримечательности, как высококлассные рестораны морепродуктов, глядя на звезду под своими знаковыми хвойными лесами, а также возможности трудоустройства в Clover Corp."

/obj/structure/sign/poster/clip/star_city
	name = "Звездный город"
	desc = "Звездный город, пустынный цветок великой границы. Многие из членов Конфедеративной лиги стремятся сделать большие состояния в своей засушливой среде или в конечном итоге без гроша в кармане, играя в азартные игры. Этот плакат продвигает самую популярную туристическую достопримечательность мегаполиса: казино всех уровней дохода, от непомерно богатых до среднего класса."

/obj/structure/sign/poster/rilena/rilena
	name = "РИЛЕНА"
	desc = "плакат RILENA: LMR с участием двух самых любимых персонажей, Ri и T4L1."

/obj/structure/sign/poster/rilena/ri
	name = "Рис"
	desc = "плакат LMR с участием Ри самостоятельно."

/obj/structure/sign/poster/rilena/tali
	name = "T4L1"
	desc = "плакат RILENA: LMR с участием любимого минибосса, T4L1."

/obj/structure/sign/poster/rilena/run
	name = "Lenelasa Me Refi"
	desc = "плакат RILENA: LMR с Ри Бег, основной механикой серии."

