/obj/item/clothing/glasses/hud/security/chameleon
	name = "охрана хамелеона"
	desc = "Украденный защитный HUD, интегрированный с технологией Syndicate chameleon. Обеспечивает защиту от вспышек."

/obj/item/clothing/glasses/hud/security/sunglasses/eyepatch
	name = "повязка глаз HUD"
	desc = "Дисплей, который подключается непосредственно к оптическому нерву пользователя, заменяя необходимость в этом бесполезном глазном яблоке."

/obj/item/clothing/glasses/hud/security/sunglasses
