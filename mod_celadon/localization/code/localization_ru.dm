	desc = "Гуппи также известен как радужная рыба из-за ярко окрашенного тела и плавников."

/obj/item/fish/plasmatetra
	name = "плазма тетра"
	desc = "Из-за своего небольшого размера тетры являются добычей многих хищников в их водном мире, включая угрей, ракообразных и беспозвоночных."

/obj/item/fish/catfish
	name = "кори сом"
	desc = "Сом имеет около 100 000 вкусовых рецепторов, и их тела покрыты ими, чтобы помочь обнаружить химические вещества, присутствующие в воде."

/obj/item/fish/bass
	name = "бас-гитарист"
	desc = "Большая, плотоядная пресноводная рыба, известная тем, что процветает в большинстве сред и популярна среди спортивных рыбаков."

/obj/item/fish/trout
	name = "стальная форель"
	desc = "Вид прибрежной форели, тесно связанный с лососем и имеющий глубокую историю использования в качестве источника пищи."

/obj/item/fish/salmon
	name = "розовый лосось"
	desc = "Самая известная из всех анадромных рыб! Они мигрируют вверх по рекам, когда достигают совершеннолетия, чтобы отложить яйца, а затем вернуться в море."

/obj/item/fish/perch
	name = "окунь"
	desc = "Относительно небольшой, но распространенный вид хищных рыб."

/obj/item/fish/clownfish
	name = "рыба-клоун"
	desc = "Рыбы-клоуны ловят добычу, плавая на рифе, привлекая более крупных рыб и заманивая их обратно к анемоне. Анемон будет жалить и есть большую рыбу, оставляя останки для рыбы-клоуна."

/obj/item/fish/cardinal
	name = "кардинальная рыба"
	desc = "Кардиналы часто встречаются возле морских ежей, где рыба прячется, когда ей угрожают."

/obj/item/fish/greenchromis
	name = "зеленый хром"
	desc = "Хром может варьироваться по цвету от синего до зеленого в зависимости от освещения и расстояния от огней."

/obj/item/fish/firefish
	name = "рыба-пожар"
	desc = "Чтобы общаться в дикой природе, рыба использует свой спинной плавник, чтобы предупредить других о потенциальной опасности."

/obj/item/fish/pufferfish
	name = "рыба-дурка"
	desc = "Одна рыбка содержит достаточно токсинов в печени, чтобы убить 30 человек."

/obj/item/fish/lanternfish
	name = "рыба- фонарь"
	desc = "Обычно они встречаются в районах ниже 6600 футов под поверхностью океана, они живут в полной темноте."

/obj/item/fish/dwarf_moonfish
	name = "карликовая лунная рыба"
	desc = "Обычно в дикой природе загоскианская лунная рыба размером с тунца, однако путем селективного разведения была создана меньшая порода, подходящая для содержания в качестве аквариумного питомца."

/obj/item/fish/gunner_jellyfish
	name = "стрелок медузы"
	desc = "Так называемая из-за своего сходства с артиллерийским снарядом, медуза-наводчик родом из Каликсиса, где ее любят как деликатес. Вырабатывает мягкий галлюциноген, который разрушается при приготовлении пищи."

/obj/item/fish/needlefish
	name = "игла"
	desc = "Крошечная прозрачная рыба, обитающая в больших школах в океанах Каликсиса. Обычная пища для других, более крупных рыб."

/obj/item/fish/armorfish
	name = "броненосец"
	desc = "Маленький моллюск родом из океанов Каликшиса, известный своей исключительно твердой оболочкой. Употребляется аналогично креветкам."

/obj/item/fish/emulsijack
	name = "токсичный эмульгатор"
	desc = "Ужасающий эмульгатор. Созданная в лаборатории, эта стройная, чешуйчатая рыба выделяет невидимый токсин, который эмульгирует других рыб, чтобы они могли питаться. Единственное его реальное применение — полностью испортить танк."

/obj/item/fish/ratfish
	name = "рыба-крыса"
	desc = "Крыса слишком долго подвергалась воздействию мутных вод содержания. Любая высшая сила, если бы она раскрылась, заявила бы, что дальнейшее существование крысы крайне нежелательно."

