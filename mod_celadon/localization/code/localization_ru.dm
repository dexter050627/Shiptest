/obj/structure/sign/poster/bay/bay_7
	name = "пустошь"
	desc = "Это один из пары рваных боевиков, один мужчина и одна женщина, на вершине насыпи щебня. Число \"12\" видно на их синих комбинезонах."

/obj/structure/sign/poster/bay/bay_8
	name = "Девушка-пинап Синди"
	desc = "Это история корпоративной PR-девушки Синди в особенно женской позе."

/obj/structure/sign/poster/bay/bay_9
	name = "Девушка-пинап Эми"
	desc = "Особенно это касается Эми, нимфоманки городской легенды о глубоком космосе. Как появилась эта фотография, неизвестно."

/obj/structure/sign/poster/bay/bay_10
	name = "Не паникуйте"
	desc = "На этом изображена какая-то звезда в гримасе. «Не паникуйте» пишется большими дружелюбными буквами."

/obj/structure/sign/poster/bay/bay_11
	name = "подводная лаборатория"
	desc = "Это один из легендарных экипажей предыдущего проекта компании."

/obj/structure/sign/poster/bay/bay_12
	name = "Изгой ИИ"
	desc = "На этом изображена оболочка печально известного ИИ, который катастропически сопровождал одну из самых ранних космических станций человечества. Тогда компания называлась TriOptimum."

/obj/structure/sign/poster/bay/bay_13
	name = "пользователь Arcane Arts"
	desc = "На этом изображен волшебник, заклинающий. Вы не можете понять, действительно ли это фотография или компьютерное изображение."

/obj/structure/sign/poster/bay/bay_14
	name = "Левитирующий череп"
	desc = "Именно этот портрет представляет собой летающий зачарованный череп. Его приключения вместе со своим легендарным спутником теперь угасают в истории."

/obj/structure/sign/poster/bay/bay_15
	name = "Дополненная легенда"
	desc = "Эта особая особь явно дополнена, смотрит в небо. Кибергород на заднем плане довольно панк."

/obj/structure/sign/poster/bay/bay_16
	name = "Опасная статическая"
	desc = "На этом конкретном изображении нет ничего примечательного, кроме довольно завораживающего шаблона статического монитора. по бокам плаката есть бирка, но она сорвана."

/obj/structure/sign/poster/bay/bay_17
	name = "Девушка-пинап Вэл"
	desc = "Люсис Вэл Макнейл, вертикальная претендентка на звание Экстраординарного юриста, победительница конкурса «Мисс Космос» два года подряд и фаворитка еженедельника «Юристы»."

/obj/structure/sign/poster/bay/bay_18
	name = "Дерпман, исполнитель государства"
	desc = "Здесь, чтобы защищать и служить... Ваши пончики! Щедро пропорциональный человек, он учит тебя, как важно прятать закуски."

/obj/structure/sign/poster/bay/bay_19
	name = "Уважайте Унати"
	desc = "На этом плакате изображен хорошо одетый Унатхи, получивший престижную награду. Это, по-видимому, поддерживает большее сотрудничество и гармонию между двумя расами."

/obj/structure/sign/poster/bay/bay_20
	name = "Скрелл Сумерки"
	desc = "Этот плакат изображает таинственно непостижимую инопланетную сцену. Многочисленные Скреллы можно увидеть беседующими среди больших кристаллических башен, поднимающихся над падающими волнами"

/obj/structure/sign/poster/bay/bay_21
	name = "присоединяйтесь к Fuzz!"
	desc = "Это хороший плакат о вербовке беловолосой китаянки, на котором написано: «Большие пушки, горячие женщины, хорошие времена». Охрана. Мы это сделаем"

/obj/structure/sign/poster/bay/bay_22
	name = "Ищете карьеру с волнением?"
	desc = "Рекламный плакат с темноволосой женщиной в очках и фиолетовой рубашке с надписью «Got Brains?» Есть талант? Не боитесь электрических летающих монстров, которые хотят высосать из вас душу? Тогда Ксенобиология могла бы использовать кого-то вроде тебя!, - написала она внизу."

/obj/structure/sign/poster/bay/bay_23
	name = "Безопасность прежде всего: потому что электричество не ждет!"
	desc = "плакат безопасности с бестолково выглядящей рыжей с изуродованными волосами. Каждый год сотни сотрудников НТ подвергают себя электрошоку. Играй безопасно. Избегайте подозрительных дверей после электрических штормов и всегда используйте защиту при обслуживании"

/obj/structure/sign/poster/bay/bay_24
	name = "Ответственные привычки медбей, No 259"
	desc = "На плакате с нервным генетиком написано: «Друзья говорят друзьям, что они клоны». Это может вызвать тяжелую и непоправимую эмоциональную травму, если человек не был должным образом проинформирован о своей недавней кончине. Всегда следуйте своим договорным обязательствам и сообщайте им об их недавнем омоложении"

/obj/structure/sign/poster/bay/bay_25
	name = "Безответственные привычки медбей, No2"
	desc = "Это плакат безопасности с извращенным обнаженным доктором. Сексуальные домогательства никогда не бывают нормальными. Сообщите о любых актах сексуального отклонения или домогательства, которые нарушают здоровую рабочую среду"

/obj/structure/sign/poster/bay/bay_26
	name = "Люди, которых мы знали"
	desc = "На этом плакате изображена группа солдат, сражающихся с большим мехом, фильм кажется патриотическим фильмом о войне."

/obj/structure/sign/poster/bay/bay_27
	name = "пластиковые овцы не могут кричать"
	desc = "Это постер фильма для предстоящего фильма ужасов, в передней части которого есть ИИ."

/obj/structure/sign/poster/bay/bay_28
	name = "Звезды знают любовь"
	desc = "Это постер фильма. Кровавая женщина рисует сердце в своей крови на окне космического корабля, это кажется романтической драмой."

/obj/structure/sign/poster/bay/bay_29
	name = "Зима приближается"
	desc = "На плакате устрашающе большой волк, он предупреждает: «Только вы можете удержать город от замерзания во время планетарного затмения!»"

/obj/structure/sign/poster/bay/bay_30
