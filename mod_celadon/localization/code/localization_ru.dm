	name = ""
	desc = ""

/obj/item/clothing/under/nanotrasen/officer
	name = "офицерские штаны"
	desc = "Неукрашенная униформа в Nanotrasen Blue. Хотя он не так хорош, как капитанская форма, цвет и качество по-прежнему отмечают его владельца как часть управленческого класса Nanotrasen."

/obj/item/clothing/under/nanotrasen/officer/skirt
	name = "юбка офицера"
	desc = "Неукрашенная униформа в Nanotrasen Blue. Хотя он не так хорош, как капитанская форма, цвет и качество по-прежнему отмечают его владельца как часть управленческого класса Nanotrasen."

