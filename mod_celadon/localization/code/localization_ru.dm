/obj/item/clothing/glasses/regular/thin
	name = "тонкие очки"
	desc = "Более дорогой, более хрупкий и гораздо менее практичный, но такой модный."

/obj/item/clothing/glasses/regular/pincher
	name = "очки для пинчеров"
	desc = "Безрукие очки, которые обрезают лицо владельца. Идеально подходит для старых профессоров и тех, у кого нет ушей."

/obj/item/clothing/glasses/regular/pincher/thin
	name = "тонкие пинчерные очки"
	desc = "Безрукие очки, которые обрезают лицо владельца. Эти более тонкие и гораздо более стильные."

/obj/item/clothing/glasses/sunglasses
	name = "солнечные очки"
	desc = "Странно древняя технология, используемая для обеспечения рудиментарного покрытия глаз. Улучшенные защитные блоки мигают."

/obj/item/clothing/glasses/sunglasses/reagent
	name = "пивные очки"
	desc = "пара солнцезащитных очков, оснащенных аппаратом для сканирования реагентов, а также обеспечивающих врожденное понимание вязкости жидкости во время движения."

/obj/item/clothing/glasses/sunglasses/chemical
	name = "научные очки"
	desc = "пара липких фиолетовых солнцезащитных очков, которые позволяют владельцу распознавать различные химические соединения только взглядом."

/obj/item/clothing/glasses/sunglasses/ballistic
	name = "баллистические очки"
	desc = "пара флеш-защищенных баллистических очков."

/obj/item/clothing/glasses/welding
	name = "сварочные очки"
	desc = "Защищает глаза от ярких вспышек; одобрено ассоциацией безумных учёных."

/obj/item/clothing/glasses/blindfold
	name = "повязка"
	desc = "Охватывает глаза, предотвращая зрение."

/obj/item/clothing/glasses/trickblindfold
