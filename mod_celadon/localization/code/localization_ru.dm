/obj/structure/sign/poster/official/cohiba_robusto_ad
	name = "Cohiba Robusto Ad"
	desc = "Cohiba Robusto, стильная сигара от Centcom."

/obj/structure/sign/poster/official/fruit_bowl
	name = "Фруктовая чаша"
